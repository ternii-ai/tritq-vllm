diff --git a/tools/tq_exact/tq_exact.cpp b/tools/tq_exact/tq_exact.cpp
new file mode 100644
index 000000000..79fbe1e63
--- /dev/null
+++ b/tools/tq_exact/tq_exact.cpp
@@ -0,0 +1,80 @@
+// tq_exact: every TQ*_128 tensor of a GGUF is dequantised on the CUDA backend (GET_ROWS -> f32, the same device
+// function the cuBLAS / to_fp16 path uses) and compared BITWISE with the CPU reference dequantize_row_*.
+// usage: tq-exact <model.gguf> [max_rows_per_tensor (0 = all)]
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-cuda.h"
+#include "gguf.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+static bool is_tq(ggml_type t) { return t == GGML_TYPE_TQ9_128 || t == GGML_TYPE_TQ27_128 || t == GGML_TYPE_TQ81_128; }
+
+int main(int argc, char ** argv) {
+    if (argc < 2) { fprintf(stderr, "usage: %s model.gguf [max_rows]\n", argv[0]); return 1; }
+    const int64_t max_rows = argc > 2 ? atoll(argv[2]) : 0;
+    ggml_context * meta = nullptr;
+    gguf_init_params ip = { /*no_alloc*/ true, &meta };
+    gguf_context * g = gguf_init_from_file(argv[1], ip);
+    if (!g) { fprintf(stderr, "cannot open %s\n", argv[1]); return 1; }
+    FILE * f = fopen(argv[1], "rb");
+    const size_t data_off = gguf_get_data_offset(g);
+    ggml_backend_t be = ggml_backend_cuda_init(0);
+
+    int64_t n_tensors = 0, n_exact = 0, n_weights = 0;
+    const int64_t CH = 8192;                                   // rows per chunk
+    for (int64_t ti = 0; ti < gguf_get_n_tensors(g); ++ti) {
+        const char * name = gguf_get_tensor_name(g, ti);
+        ggml_tensor * mt = ggml_get_tensor(meta, name);
+        if (!is_tq(mt->type)) continue;
+        const int64_t K = mt->ne[0];
+        const int64_t R = ggml_nrows(mt);
+        const size_t rs = ggml_row_size(mt->type, K);
+        const int64_t Rt = max_rows > 0 && max_rows < R ? max_rows : R;
+        bool exact = true;
+        std::vector<char> raw(rs*CH);
+        std::vector<float> ref(K*CH), got(K*CH);
+        const ggml_type_traits * tr = ggml_get_type_traits(mt->type);
+        for (int64_t r0 = 0; r0 < Rt && exact; r0 += CH) {
+            const int64_t nr = std::min(CH, Rt - r0);
+            fseeko(f, (off_t) (data_off + gguf_get_tensor_offset(g, ti) + r0*rs), SEEK_SET);
+            if (fread(raw.data(), 1, rs*nr, f) != rs*nr) { fprintf(stderr, "read error\n"); return 1; }
+            for (int64_t r = 0; r < nr; ++r) tr->to_float(raw.data() + r*rs, ref.data() + r*K, K);
+
+            ggml_init_params cp = { ggml_tensor_overhead()*8 + ggml_graph_overhead(), nullptr, true };
+            ggml_context * c = ggml_init(cp);
+            ggml_tensor * W = ggml_new_tensor_2d(c, mt->type, K, nr);
+            ggml_tensor * I = ggml_new_tensor_1d(c, GGML_TYPE_I32, nr);
+            ggml_tensor * O = ggml_get_rows(c, W, I);
+            ggml_cgraph * gr = ggml_new_graph(c);
+            ggml_build_forward_expand(gr, O);
+            ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(c, be);
+            std::vector<int32_t> idx(nr);
+            for (int64_t r = 0; r < nr; ++r) idx[r] = (int32_t) r;
+            ggml_backend_tensor_set(W, raw.data(), 0, rs*nr);
+            ggml_backend_tensor_set(I, idx.data(), 0, nr*sizeof(int32_t));
+            ggml_backend_graph_compute(be, gr);
+            ggml_backend_tensor_get(O, got.data(), 0, nr*K*sizeof(float));
+            if (memcmp(got.data(), ref.data(), nr*K*sizeof(float)) != 0) {
+                for (int64_t i = 0; i < nr*K; ++i) if (memcmp(&got[i], &ref[i], 4)) {
+                    fprintf(stderr, "MISMATCH %s row %lld col %lld: cuda %.9g cpu %.9g\n", name, (long long)(r0 + i/K), (long long)(i%K), got[i], ref[i]);
+                    break;
+                }
+                exact = false;
+            }
+            ggml_backend_buffer_free(buf);
+            ggml_free(c);
+        }
+        n_tensors++; n_exact += exact; n_weights += Rt*K;
+        if (!exact) printf("DIFFER %s %s\n", name, ggml_type_name(mt->type));
+    }
+    printf("{\"model\": \"%s\", \"tq_tensors\": %lld, \"exact\": %lld, \"weights_checked\": %lld, \"verdict\": \"%s\"}\n",
+           argv[1], (long long) n_tensors, (long long) n_exact, (long long) n_weights, n_tensors == n_exact ? "EXACT" : "DIFFER");
+    ggml_backend_free(be);
+    fclose(f);
+    return n_tensors == n_exact ? 0 : 2;
+}
