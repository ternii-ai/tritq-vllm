+++ b/ggml/src/ggml-cuda/tq.cuh
@@ -0,0 +1,99 @@
+#pragma once
+
+#include "common.cuh"
+
+// Dense trit TQ*_128 (see ggml-common.h for the format): one fp16 key per 128 weights, 26 mixed-radix words per block,
+// weight j = word j % 26, digit j / 26.  Decode (multiply-only): t = word; 5x { t *= N; u = t >> W; t &= 2^W - 1 }
+// (W = 32: u = mulhi(t, N); t *= N).  Value = (u - (N-1)/2) * d, computed in f32 exactly as the CPU reference does.
+
+static __host__ __device__ constexpr bool ggml_cuda_type_is_tq(ggml_type type) {
+    return type == GGML_TYPE_TQ9_128 || type == GGML_TYPE_TQ27_128 || type == GGML_TYPE_TQ81_128;
+}
+
+template <ggml_type type> struct tq_traits;
+template <> struct tq_traits<GGML_TYPE_TQ9_128> {
+    typedef block_tq9_128 block;
+    static constexpr int N = TQ9_N, W = TQ9_W;
+    static __device__ __forceinline__ uint32_t word(const block & b, int w) { return b.lo[w]; }
+};
+template <> struct tq_traits<GGML_TYPE_TQ27_128> {
+    typedef block_tq27_128 block;
+    static constexpr int N = TQ27_N, W = TQ27_W;
+    static __device__ __forceinline__ uint32_t word(const block & b, int w) { return b.lo[w] | ((uint32_t) b.hi[w] << 16); }
+};
+template <> struct tq_traits<GGML_TYPE_TQ81_128> {
+    typedef block_tq81_128 block;
+    static constexpr int N = TQ81_N, W = TQ81_W;
+    static __device__ __forceinline__ uint32_t word(const block & b, int w) { return b.lo[w] | ((uint32_t) b.hi[w] << 16); }
+};
+
+// one decode step: returns digit u, advances t
+template <int N, int W>
+static __device__ __forceinline__ int tq_step(uint32_t & t) {
+    if constexpr (W == 32) {
+        const int u = __umulhi(t, (uint32_t) N);
+        t *= (uint32_t) N;
+        return u;
+    } else {
+        t *= (uint32_t) N;
+        const int u = t >> W;
+        t &= (1u << W) - 1;
+        return u;
+    }
+}
+
+
+// N^i mod 2^32
+template <int N, int i> struct tq_pow { static constexpr uint32_t v = (uint32_t) N * tq_pow<N, i - 1>::v; };
+template <int N> struct tq_pow<N, 0> { static constexpr uint32_t v = 1; };
+
+// All 5 codes of a word as floats (u - L), branch-free and with independent operations per digit (mat-vec path):
+//   X = word << (32 - W) is the same fraction in Q32; digit i = mulhi(X * N^i mod 2^32, N)  (exhaustively checked
+//   identical to the multiply-shift-mask chain for every word of N = 9, 27, 81);
+//   int -> float without I2F: float bits 0x4B000000 | u = 2^23 + u (u < 2^23), minus (2^23 + L) is exact.
+template <int N, int W>
+static __device__ __forceinline__ void tq_codes5(const uint32_t word, float q[5]) {
+    constexpr float off = 8388608.0f + (float)((N - 1)/2);
+    const uint32_t X = W == 32 ? word : word << (32 - W);
+    q[0] = __int_as_float(0x4B000000 | __umulhi(X,                     (uint32_t) N)) - off;
+    q[1] = __int_as_float(0x4B000000 | __umulhi(X*tq_pow<N, 1>::v, (uint32_t) N)) - off;
+    q[2] = __int_as_float(0x4B000000 | __umulhi(X*tq_pow<N, 2>::v, (uint32_t) N)) - off;
+    q[3] = __int_as_float(0x4B000000 | __umulhi(X*tq_pow<N, 3>::v, (uint32_t) N)) - off;
+    q[4] = __int_as_float(0x4B000000 | __umulhi(X*tq_pow<N, 4>::v, (uint32_t) N)) - off;
+}
+
+// digit i of a word (0..4)
+template <int N, int W>
+static __device__ __forceinline__ int tq_digit(uint32_t t, const int i) {
+    int u = 0;
+#pragma unroll
+    for (int k = 0; k < 5; ++k) {
+        const int uk = tq_step<N, W>(t);
+        if (k == i) {
+            u = uk;
+        }
+    }
+    return u;
+}
+
+// dequantize_kernel_t form (qr = 2): v.x = weight iqs, v.y = weight iqs + 64 of block ib
+template <ggml_type type>
+static __device__ __forceinline__ void dequantize_tq(const void * vx, const int64_t ib, const int iqs, float2 & v) {
+    typedef tq_traits<type> tr;
+    const typename tr::block & b = ((const typename tr::block *) vx)[ib];
+    constexpr int L = (tr::N - 1)/2;
+    const float d = __half2float(b.d);
+    const int j0 = iqs, j1 = iqs + QK_TQD/2;
+    const int u0 = tq_digit<tr::N, tr::W>(tr::word(b, j0 % TQD_NW), j0 / TQD_NW);
+    const int u1 = tq_digit<tr::N, tr::W>(tr::word(b, j1 % TQD_NW), j1 / TQD_NW);
+    v.x = (float)(u0 - L) * d;
+    v.y = (float)(u1 - L) * d;
+}
+
+#define QR_TQD 2
+
+#define TQ_MMV_MAX_COLS 8
+
+// Decode mat-vec / MoE mat-vec for TQ src0, f32 src1/dst. Returns false if the shape is not handled (caller falls back).
+bool ggml_cuda_tq_mul_mat_vec(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1,
+                              const ggml_tensor * ids, ggml_tensor * dst);
