@@ -739,6 +739,38 @@ ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_gated_delta_net(
     return res;
 }
 
+// TQ step-2: GDN with the input prep folded in (one token, K = 1, G = 1, S_v = 128)
+ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_gated_delta_net_prep(ggml_metal_library_t lib, const ggml_tensor * op) {
+    char base[256];
+    char name[256];
+
+    const int ne20 = op->src[2]->ne[0];
+    const int ne30 = op->src[3]->ne[0];
+    const int K    = ggml_get_op_params_i32(op, 0);
+
+    GGML_ASSERT(ne20 == 128 && ne30 == 1 && K == 1);
+
+    snprintf(base, 256, "kernel_gated_delta_net_prep_f32_4");
+    snprintf(name, 256, "%s_ne20=%d_ne30=%d_K=%d", base, ne20, ne30, K);
+
+    ggml_metal_pipeline_with_params res = ggml_metal_library_get_pipeline(lib, name);
+    if (!res.pipeline) {
+        ggml_metal_cv_t cv = ggml_metal_cv_init();
+
+        ggml_metal_cv_set_int16(cv, ne20, FC_GATED_DELTA_NET + 0);
+        ggml_metal_cv_set_int16(cv, ne30, FC_GATED_DELTA_NET + 1);
+        ggml_metal_cv_set_int16(cv, K,    FC_GATED_DELTA_NET + 2);
+
+        res = ggml_metal_library_compile_pipeline(lib, base, name, cv);
+
+        ggml_metal_cv_free(cv);
+    }
+
+    res.nsg = 4;
+
+    return res;
+}
