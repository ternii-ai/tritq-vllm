@@ -6034,3 +6098,210 @@ int ggml_metal_op_count_equal(ggml_metal_op_t ctx, int idx) {
 
     return 1;
 }
+
+
+// =====================================================================================================
+// TQ step-2: step-2 decode fusions, ported to the upstream
+// ff5a233 Metal backend. Planned once per graph in graph_optimize (before reorder and allocation): absorbed nodes
+// get GGML_METAL_S2_ELIDE (they emit nothing), the chain's LAST node does all the work and gets the activation inputs
+// as extra sources - this keeps them alive in the allocator and makes the concurrency / barrier logic see them.
+// A consumer check refuses a fusion if an absorbed intermediate has any other reader. Decode only (one token, one
+// sequence); prefill graphs are untouched. Both off by default.
+//   GGML_METAL_OPT_GDNPREP=1: SCALE(RMS_NORM(q)), SCALE(RMS_NORM(k)), MUL(softplus(ADD(alpha, dt)), A), sigmoid(beta)
+//                             -> computed inside the GATED_DELTA_NET kernel (src 6..9 = q raw, k raw, alpha, beta raw)
+//   GGML_METAL_OPT_NGATED=1:  MUL(MUL(RMS_NORM(x), w), sigmoid|silu(z)) -> one row kernel at the final MUL (src 2..4 = x, w, z)
+// =====================================================================================================
+
+static bool s2_env(const char * name) { const char * e = getenv(name); return e && atoi(e) != 0; }
+static bool s2_opt_gdnprep() { static int v = -1; if (v < 0) v = s2_env("GGML_METAL_OPT_GDNPREP"); return v; }
+static bool s2_opt_ngated()  { static int v = -1; if (v < 0) v = s2_env("GGML_METAL_OPT_NGATED");  return v; }
+static int  s2_prep_mask()   { static int v = -1; if (v < 0) { const char * e = getenv("GGML_METAL_S2_PREP_MASK"); v = e ? atoi(e) : 15; } return v; }   // diagnostic: bit 0 q, 1 k, 2 gate, 3 beta (default 15 = all)
+static bool s2_debug()       { static int v = -1; if (v < 0) v = s2_env("GGML_METAL_S2_DEBUG");    return v; }
+
+static const ggml_tensor * s2_base(const ggml_tensor * t) {
+    return t->view_src ? t->view_src : t;
+}
+
+// consumer map of the graph being planned: tensor -> nodes that read it directly or through a view of it (built once per plan)
+static std::unordered_map<const ggml_tensor *, std::vector<const ggml_tensor *>> s2_consumers;
+
+static void s2_build_consumers(const ggml_cgraph * gf) {
+    s2_consumers.clear();
+    for (int j = 0; j < gf->n_nodes; ++j) {
+        const ggml_tensor * nj = gf->nodes[j];
+        for (int k = 0; k < GGML_MAX_SRC; ++k) {
+            const ggml_tensor * sj = nj->src[k];
+            if (!sj) continue;
+            s2_consumers[sj].push_back(nj);
+            if (sj->view_src && sj->view_src != sj) s2_consumers[sj->view_src].push_back(nj);
+        }
+    }
+}
+
+// every node that reads t (directly or through a view of t) must be in `allowed`, or be a view / reshape of t whose own
+// readers are all allowed
+static bool s2_only_consumer(const ggml_cgraph * gf, const ggml_tensor * t, const ggml_tensor * const * allowed, int n_allowed) {
+    auto it = s2_consumers.find(t);
+    if (it == s2_consumers.end()) return true;
+    for (const ggml_tensor * nj : it->second) {
+        if (nj == t) continue;
+        bool ok = false;
+        for (int a = 0; a < n_allowed; ++a) if (nj == allowed[a]) { ok = true; break; }
+        if (ok) continue;
+        if (nj->view_src == t || nj->op == GGML_OP_RESHAPE || nj->op == GGML_OP_VIEW) {
+            if (!s2_only_consumer(gf, nj, allowed, n_allowed)) return false;
+            continue;
+        }
+        return false;
+    }
+    return true;
+}
+
+static bool s2_is_unary(const ggml_tensor * t, ggml_unary_op u) {
+    return t && t->op == GGML_OP_UNARY && ggml_get_unary_op(t) == u;
+}
+
+static bool s2_vec(const ggml_tensor * t, int64_t n) {
+    return t && t->type == GGML_TYPE_F32 && ggml_nelements(t) == n && ggml_is_contiguous(t);
+}
+
+static int s2_plan_gdnprep(ggml_cgraph * gf) {
+    int n_ok = 0;
+    for (int i = 0; i < gf->n_nodes; ++i) {
+        ggml_tensor * g = gf->nodes[i];
+        if (g->op != GGML_OP_GATED_DELTA_NET || (g->flags & GGML_METAL_S2_GDNPREP)) continue;
+        const ggml_tensor * v = g->src[2];
+        const int64_t H = v->ne[1];
+        ggml_tensor * Sq = g->src[0];
+        ggml_tensor * Sk = g->src[1];
+        if (!Sq || Sq->op != GGML_OP_SCALE || !Sk || Sk->op != GGML_OP_SCALE) continue;
+        if (ggml_get_op_params_f32(Sq, 1) != 0.0f || ggml_get_op_params_f32(Sk, 1) != 0.0f) continue;   // no bias
+        ggml_tensor * Lq = Sq->src[0];
+        ggml_tensor * Lk = Sk->src[0];
+        if (!Lq || Lq->op != GGML_OP_RMS_NORM || !Lk || Lk->op != GGML_OP_RMS_NORM) continue;
+        ggml_tensor * Mg = (ggml_tensor *) s2_strip_views(g->src[3]);
+        ggml_tensor * Ub = g->src[4];
+        if (!Mg || Mg->op != GGML_OP_MUL || !s2_is_unary(Ub, GGML_UNARY_OP_SIGMOID)) continue;
+        ggml_tensor * Us = Mg->src[0];
+        if (!s2_is_unary(Us, GGML_UNARY_OP_SOFTPLUS)) continue;
+        ggml_tensor * Ad = (ggml_tensor *) s2_strip_views(Us->src[0]);
+        if (!Ad || Ad->op != GGML_OP_ADD) continue;
+        ggml_tensor * qr = Lq->src[0], * kr = Lk->src[0], * al = Ad->src[0], * br = Ub->src[0];
+        const ggml_tensor * A = Mg->src[1], * dt = Ad->src[1];
+        // the raw inputs become extra sources of EVERY matching GDN node - also in prefill / multi-sequence graphs, which are
+        // never fused: the scheduler may reuse one graph's allocation plan for another graph with the same node count (the
+        // prefill and decode graphs both have 6099 nodes), so all of them must carry the same lifetimes. Without this the
+        // decode graph ran on a prefill plan in which e.g. alpha is dead after its ADD: wrong gate after any batched prefill.
+        if (g->src[6] || g->src[7] || g->src[8] || g->src[9]) {
+            if (!(g->src[6] == qr && g->src[7] == kr && g->src[8] == al && g->src[9] == br)) continue;   // slots used by someone else
+        }
+        g->src[6] = qr; g->src[7] = kr; g->src[8] = al; g->src[9] = br;
+        // fuse only: one token, one sequence, S_v = 128, scalar gate per head, K = 1
+        if (v->ne[0] != 128 || v->ne[2] != 1 || v->ne[3] != 1 || g->src[3]->ne[0] != 1 || ggml_get_op_params_i32(g, 0) != 1) continue;
+        bool ok = qr->type == GGML_TYPE_F32 && kr->type == GGML_TYPE_F32 && qr->ne[0] == 128 && kr->ne[0] == 128 &&
+                  qr->nb[0] == sizeof(float) && kr->nb[0] == sizeof(float) && qr->ne[1] == Sq->ne[1] && kr->ne[1] == Sk->ne[1] &&
+                  (qr->nb[1] % 16) == 0 && (kr->nb[1] % 16) == 0 &&
+                  Sq->type == GGML_TYPE_F32 && Sk->type == GGML_TYPE_F32 && ggml_is_contiguous(Sq) && ggml_is_contiguous(Sk) &&
+                  Lq->ne[2] == 1 && Lq->ne[3] == 1 && Lk->ne[2] == 1 && Lk->ne[3] == 1 &&
+                  (H % 4) == 0 && s2_vec(A, H) && s2_vec(dt, H) && s2_vec(al, H) && s2_vec(br, H) && Ad->src[0]->ne[0] % 4 == 0 && br->ne[0] == 1 &&
+                  ggml_nelements(Mg) == H && ggml_nelements(Ub) == H && ggml_nelements(Ad) == H && ggml_nelements(Us) == H &&
+                  Mg->type == GGML_TYPE_F32 && Ub->type == GGML_TYPE_F32;
+        if (!ok) continue;
+        const ggml_tensor * a_g[] = { g }; const ggml_tensor * a_q[] = { Sq }; const ggml_tensor * a_k[] = { Sk };
+        const ggml_tensor * a_s[] = { Mg }; const ggml_tensor * a_a[] = { Us };
+        if (!s2_only_consumer(gf, Sq, a_g, 1) || !s2_only_consumer(gf, Sk, a_g, 1) || !s2_only_consumer(gf, Lq, a_q, 1) ||
+            !s2_only_consumer(gf, Lk, a_k, 1) || !s2_only_consumer(gf, Mg, a_g, 1) || !s2_only_consumer(gf, Ub, a_g, 1) ||
+            !s2_only_consumer(gf, Us, a_s, 1) || !s2_only_consumer(gf, Ad, a_a, 1)) continue;
+        const int pm = s2_prep_mask();
+        if (pm & 1) { Sq->flags |= GGML_METAL_S2_ELIDE; Lq->flags |= GGML_METAL_S2_ELIDE; }
+        if (pm & 2) { Sk->flags |= GGML_METAL_S2_ELIDE; Lk->flags |= GGML_METAL_S2_ELIDE; }
+        if (pm & 4) { Mg->flags |= GGML_METAL_S2_ELIDE; Us->flags |= GGML_METAL_S2_ELIDE; Ad->flags |= GGML_METAL_S2_ELIDE; }
+        if (pm & 8) { Ub->flags |= GGML_METAL_S2_ELIDE; }
+        g->flags |= GGML_METAL_S2_GDNPREP;
+        n_ok++;
+    }
+    return n_ok;
+}
+
+static int s2_plan_ngated(ggml_cgraph * gf) {
+    int n_ok = 0;
+    for (int i = 0; i < gf->n_nodes; ++i) {
+        ggml_tensor * M2 = gf->nodes[i];
+        if (M2->op != GGML_OP_MUL || (M2->flags & (GGML_METAL_S2_NGATED | GGML_METAL_S2_ELIDE))) continue;
+        ggml_tensor * M1 = M2->src[0];
+        ggml_tensor * U  = M2->src[1];
+        if (!M1 || M1->op != GGML_OP_MUL || !(s2_is_unary(U, GGML_UNARY_OP_SIGMOID) || s2_is_unary(U, GGML_UNARY_OP_SILU))) continue;
+        ggml_tensor * N = M1->src[0];
+        if (!N || N->op != GGML_OP_RMS_NORM) continue;
+        ggml_tensor * x = N->src[0], * w = M1->src[1], * z = U->src[0];
+        // extra sources on EVERY matching node (also never-fused prefill graphs), for the same allocation-plan reason as GDNPREP
+        if (M2->src[2] || M2->src[3] || M2->src[4]) {
+            if (!(M2->src[2] == x && M2->src[3] == w && M2->src[4] == z)) continue;
+        }
+        M2->src[2] = x; M2->src[3] = w; M2->src[4] = z;
+        const int64_t ne0 = N->ne[0];
+        bool ok = ne0 == 128 && N->type == GGML_TYPE_F32 && M1->type == GGML_TYPE_F32 && M2->type == GGML_TYPE_F32 && U->type == GGML_TYPE_F32 &&
+                  x->type == GGML_TYPE_F32 && w->type == GGML_TYPE_F32 && z->type == GGML_TYPE_F32 &&
+                  x->nb[0] == sizeof(float) && (x->nb[1] % 16) == 0 && ggml_nelements(w) == ne0 && ggml_is_contiguous(w) &&
+                  ggml_are_same_shape(M2, N) && ggml_are_same_shape(M1, N) && ggml_are_same_shape(U, N) && ggml_is_contiguous(M2) &&
+                  ggml_is_contiguous(z) && ggml_nelements(z) == ggml_nelements(N) && N->ne[2] == 1 && N->ne[3] == 1 &&
+                  !(x->flags & GGML_METAL_S2_ELIDE) && !(z->flags & GGML_METAL_S2_ELIDE);
+        if (!ok) continue;
+        const ggml_tensor * a_n[] = { M1 }; const ggml_tensor * a_m[] = { M2 };
+        if (!s2_only_consumer(gf, N, a_n, 1) || !s2_only_consumer(gf, M1, a_m, 1) || !s2_only_consumer(gf, U, a_m, 1)) continue;
+        N->flags |= GGML_METAL_S2_ELIDE; M1->flags |= GGML_METAL_S2_ELIDE; U->flags |= GGML_METAL_S2_ELIDE;
+        M2->flags |= GGML_METAL_S2_NGATED;
+        n_ok++;
+    }
+    return n_ok;
+}
+
+void ggml_metal_s2_plan(ggml_cgraph * gf, void * user_data, void (*add_alloc_dep)(void *, struct ggml_tensor *, struct ggml_tensor *)) {
+    GGML_UNUSED(user_data); GGML_UNUSED(add_alloc_dep);   // lifetimes come from the extra sources (all graphs), see s2_plan_gdnprep
+    const bool gp = s2_opt_gdnprep(), ng = s2_opt_ngated();
+    if (!gp && !ng) return;
+    const int64_t t0 = ggml_time_us();
+    s2_build_consumers(gf);
+    const int a = gp ? s2_plan_gdnprep(gf) : 0;
+    if (a > 0) s2_build_consumers(gf);   // GDNPREP added sources
+    const int b = ng ? s2_plan_ngated(gf)  : 0;
+    const int n_dep = 0;
+    if (s2_debug()) {
+        static int n_print = 0;
+        if (n_print++ < 64) fprintf(stderr, "[tq-s2] plan (n_nodes %d): gdnprep %d, ngated %d (%d), %.3f ms\n", gf->n_nodes, a, b, n_dep, (ggml_time_us() - t0)/1000.0);
+    }
+}
+
+int ggml_metal_op_s2_norm_gated(ggml_metal_op_t ctx, int idx) {
+    ggml_tensor * M2 = ctx->node(idx);
+    const ggml_tensor * M1 = M2->src[0];
+    const ggml_tensor * U  = M2->src[1];
+    const ggml_tensor * N  = M1->src[0];
+    ggml_tensor * x = M2->src[2], * w = M2->src[3], * z = M2->src[4];
+    GGML_ASSERT(N && N->op == GGML_OP_RMS_NORM && x && w && z);
+    float eps; memcpy(&eps, N->op_params, sizeof(float));
+    const bool sig = ggml_get_unary_op(U) == GGML_UNARY_OP_SIGMOID;
+    ggml_metal_kargs_norm args = {};
+    args.ne00 = (int32_t) N->ne[0]; args.ne00_t = args.ne00/4;
+    args.nb1 = M2->nb[1]; args.nb2 = M2->nb[2]; args.nb3 = M2->nb[3]; args.eps = eps;
+    args.nbf1[0] = x->nb[1]; args.nbf2[0] = x->nb[2]; args.nbf3[0] = x->nb[3];
+    args.nbf1[1] = z->nb[1]; args.nbf2[1] = z->nb[2]; args.nbf3[1] = z->nb[3];   // z row strides (reused field)
+    const char * kname = sig ? "kernel_rms_norm_gated_sigmoid_f32_4" : "kernel_rms_norm_gated_silu_f32_4";
+    auto pl = ggml_metal_library_get_pipeline(ctx->lib, kname);
+    if (!pl.pipeline) pl = ggml_metal_library_compile_pipeline(ctx->lib, kname, kname, nullptr);
+    // stock rms_norm thread count: 32, grown while < ne00_t, capped at round_up(ne00_t, 32) -> 32 for ne00 = 128
+    int nth = 32;
+    while (nth < args.ne00_t && nth < ggml_metal_pipeline_max_theads_per_threadgroup(pl)) nth *= 2;
+    nth = std::min(nth, ggml_metal_pipeline_max_theads_per_threadgroup(pl));
+    nth = std::min(nth, (args.ne00_t + 31)/32*32);
+    GGML_ASSERT(nth == 32 && args.ne00_t == 32 && "ngated: one simdgroup per row (ne00 = 128)");
+    ggml_metal_encoder_set_pipeline(ctx->enc, pl);
+    ggml_metal_encoder_set_bytes   (ctx->enc, &args, sizeof(args), 0);
+    ggml_metal_encoder_set_buffer  (ctx->enc, ggml_metal_get_buffer_id(x),  1);
+    ggml_metal_encoder_set_buffer  (ctx->enc, ggml_metal_get_buffer_id(w),  2);
+    ggml_metal_encoder_set_buffer  (ctx->enc, ggml_metal_get_buffer_id(z),  3);
+    ggml_metal_encoder_set_buffer  (ctx->enc, ggml_metal_get_buffer_id(M2), 4);
+    ggml_metal_encoder_set_threadgroup_memory_size(ctx->enc, (32 + 2*32*4)*sizeof(float), 0);
+    ggml_metal_encoder_dispatch_threadgroups(ctx->enc, N->ne[1], N->ne[2], N->ne[3], nth, 1, 1);
+    return 1;
+}
