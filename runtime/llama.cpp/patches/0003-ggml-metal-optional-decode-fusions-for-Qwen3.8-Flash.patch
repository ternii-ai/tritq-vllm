diff --git a/ggml/src/ggml-metal/kernels/gated_delta_net.metal b/ggml/src/ggml-metal/kernels/gated_delta_net.metal
index 5e4861e..ee3d2fb 100644
--- a/ggml/src/ggml-metal/kernels/gated_delta_net.metal
+++ b/ggml/src/ggml-metal/kernels/gated_delta_net.metal
@@ -151,6 +151,153 @@ template [[host_name("kernel_gated_delta_net_f32_1")]] kernel kernel_gated_delta
 template [[host_name("kernel_gated_delta_net_f32_2")]] kernel kernel_gated_delta_net_t kernel_gated_delta_net_impl<2>;
 template [[host_name("kernel_gated_delta_net_f32_4")]] kernel kernel_gated_delta_net_t kernel_gated_delta_net_impl<4>;
 
+// TQ step-2: kernel_gated_delta_net_impl<4> (one token, K = 1, G = 1) with the GDN input prep folded in
+// (GGML_METAL_OPT_GDNPREP). No threadgroup memory and no barrier: in the main loop lane tx of every simdgroup needs exactly
+// q[4tx..4tx+3] and k[4tx..4tx+3], i.e. its own float4 of the l2 norm, so each simdgroup computes the two norms itself as the
+// stock fused RMS_NORM + SCALE does (kernel_rms_norm_mul_f32_4 use_scale, 32 threads: lane t owns float4 t, 0 + dot, simd_sum,
+// the second-stage simd_sum only adds zeros; y = (x*scale)*s), and every lane computes the per-head gate
+// softplus(alpha + dt) * A (the stock SOFTPLUS runs its float4 kernel: evaluated here on the head's aligned group of 4).
+// and sigmoid(beta) (the stock SIGMOID runs its scalar kernel: the beta view has ne0 = 1).
+// mask (GGML_METAL_S2_PREP_MASK, default 15): bit 0 q, 1 k, 2 gate, 3 beta folded; an unfolded part is read from the stock tensor.
+kernel void kernel_gated_delta_net_prep_f32_4(
+        constant ggml_metal_kargs_gated_delta_net & args,
+        device const char * q,
+        device const char * k,
+        device const char * v,
+        device const char * g,
+        device const char * b,
+        device const char * s,
+        device       char * dst,
+        device       char * dst_fuse,
+        device const char  * q_raw,
+        device const char  * k_raw,
+        device const float * alpha,
+        device const float * dt,
+        device const float * A,
+        device const float * b_raw,
+        constant ggml_metal_kargs_gdn_prep & pargs,
+        uint3 tgpig[[threadgroup_position_in_grid]],
+        uint3 tpitg[[thread_position_in_threadgroup]],
+        uint3   ntg[[threads_per_threadgroup]])  {
+#define S_v FC_gated_delta_net_ne20
+    constexpr short NSG = 4;
+
+    const uint tx = tpitg.x;
+    const uint ty = tpitg.y;
+
+    const uint i23 = tgpig.z; // B (n_seqs)
+    const uint i21 = tgpig.y; // H (head)
+    const uint i20 = tgpig.x*NSG + ty; // row within S_v
+
+    const uint i01 = i21 % args.ne01;
+    const uint i11 = i21 % args.ne11;
+
+    const float scale = 1.0f / sqrt((float)S_v);
+
+    // the state first, as the stock kernel
+    const uint state_in_base = (i23*args.ne21 + i21)*S_v*S_v + i20*S_v;
+    device const float * s_ptr = (device const float *) (s) + state_in_base;
+
+    float ls[NSG];
+
+    FOR_UNROLL (short j = 0; j < NSG; j++) {
+        const short is = tx*NSG + j;
+        ls[j] = s_ptr[is];
+    }
+
+    // ---- prep (registers only) ----
+    float4 qv, kv;
+    if (pargs.mask & 1) {
+        const float4 xv = ((device const float4 *) (q_raw + i23*pargs.q_nb3 + i01*pargs.q_nb1))[tx];
+        float sumf = 0.0f;
+        sumf += dot(xv, xv);
+        sumf = simd_sum(sumf);
+        const float mean = sumf/pargs.ne00q;
+        const float scl  = 1.0f/sqrt(mean + pargs.eps_q);
+        qv = (xv*scl) * pargs.scale_q;
+    } else {
+        qv = ((device const float4 *) (q + i23*args.nb03 + i01*args.nb01))[tx];
+    }
+    if (pargs.mask & 2) {
+        const float4 xv = ((device const float4 *) (k_raw + i23*pargs.k_nb3 + i11*pargs.k_nb1))[tx];
+        float sumf = 0.0f;
+        sumf += dot(xv, xv);
+        sumf = simd_sum(sumf);
+        const float mean = sumf/pargs.ne00q;
+        const float scl  = 1.0f/sqrt(mean + pargs.eps_k);
+        kv = (xv*scl) * pargs.scale_k;
+    } else {
+        kv = ((device const float4 *) (k + i23*args.nb13 + i11*args.nb11))[tx];
+    }
+    float gv;
+    if (pargs.mask & 4) {
+        const uint i4 = i21 & ~3u;
+        const uint ih = i23*args.ne21 + i4;
+        const float4 x4 = float4(alpha[ih], alpha[ih + 1], alpha[ih + 2], alpha[ih + 3]) +
+                          float4(dt[i4],    dt[i4 + 1],    dt[i4 + 2],    dt[i4 + 3]);
+        const float4 sp4 = select(log(1 + exp(x4)), x4, x4 > 20);
+        gv = sp4[i21 - i4] * A[i21];
+    } else {
+        gv = ((device const float *) (g))[i23*args.ne22*args.ne21 + i21];
+    }
+    float bv;
+    if (pargs.mask & 8) {
+        const float x = b_raw[i23*args.ne21 + i21];
+        bv = (1 / (1 + exp(-x)));   // kernel_unary SIGMOID (scalar: the beta view has ne0 = 1)
+    } else {
+        bv = ((device const float *) (b))[i23*args.ne22*args.ne21 + i21];
+    }
+
+    device float * dst_attn = (device float *) (dst) + (i23*args.ne22*args.ne21 + i21)*S_v + i20;
+    device const float * v_ptr = (device const float *) (v + i23*args.nb23 + i21*args.nb21);
+
+    const uint state_out_base = (i23*args.ne21 + i21)*S_v*S_v + i20*S_v;
+    const uint attn_size = args.ne22 * args.ne21 * S_v * args.ne23;
+
+    const bool fused = args.nb_out > 0;
+    const device float * state_out = fused ? (device float *)dst_fuse : (device float *)dst + attn_size;
+
+    {
+        float s_k = 0.0f;
+
+        const float g_exp = exp(gv);
+
+        FOR_UNROLL (short j = 0; j < NSG; j++) {
+            ls[j] *= g_exp;
+
+            s_k += ls[j]*kv[j];
+        }
+
+        s_k = simd_sum(s_k);
+
+        const float d = (v_ptr[i20] - s_k)*bv;
+
+        float y = 0.0f;
+
+        FOR_UNROLL (short j = 0; j < NSG; j++) {
+            ls[j] += kv[j]*d;
+
+            y += ls[j]*qv[j];
+        }
+
+        y = simd_sum(y);
+
+        if (tx == 0) {
+            dst_attn[0] = y*scale;
+        }
+    }
+
+    {
+        device float * dst_state = (device float *)state_out + state_out_base;
+        FOR_UNROLL (short j = 0; j < NSG; j++) {
+            const short is = tx*NSG + j;
+            dst_state[is] = ls[j];
+        }
+    }
+
+#undef S_v
+}
+
 #else
 // a simplified version of the above
 // no performance improvement, so keep the above version for now
diff --git a/ggml/src/ggml-metal/kernels/norm.metal b/ggml/src/ggml-metal/kernels/norm.metal
index c76d0c7..5f4dfdd 100644
--- a/ggml/src/ggml-metal/kernels/norm.metal
+++ b/ggml/src/ggml-metal/kernels/norm.metal
@@ -183,6 +183,79 @@ template [[host_name("kernel_rms_norm_f32_4")]]         kernel kernel_rms_norm_f
 template [[host_name("kernel_rms_norm_mul_f32_4")]]     kernel kernel_rms_norm_fuse_t kernel_rms_norm_fuse_impl<float4, 2>;
 template [[host_name("kernel_rms_norm_mul_add_f32_4")]] kernel kernel_rms_norm_fuse_t kernel_rms_norm_fuse_impl<float4, 3>;
 
+// TQ step-2: y = (RMS_NORM(x)*w) * gate(z) in ONE dispatch (GGML_METAL_OPT_NGATED), GT = 0: sigmoid (qwen4exp),
+// GT = 1: silu (qwen3.5). Reduction = kernel_rms_norm_fuse_impl<float4, 2> with the stock 32 threads (one float4 each, ne00 = 128);
+// gate = kernel_unary SIGMOID / SILU; product = kernel_bin MUL. Both factors go through threadgroup memory before the product,
+// as the stock kernels pass them through device memory.
+template <short GT>
+kernel void kernel_rms_norm_gated_impl(
+        constant ggml_metal_kargs_norm & args,
+        device const char * src_x,
+        device const char * src_w,
+        device const char * src_z,
+        device       char * dst,
+        threadgroup float * shmem_f32 [[threadgroup(0)]],
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg[[thread_position_in_threadgroup]],
+        ushort  sgitg[[simdgroup_index_in_threadgroup]],
+        ushort  tiisg[[thread_index_in_simdgroup]],
+        ushort3   ntg[[threads_per_threadgroup]]) {
+    if (sgitg == 0) {
+        shmem_f32[tiisg] = 0.0f;
+    }
+
+    const int i01 = tgpig.x;
+    const int i02 = tgpig.y;
+    const int i03 = tgpig.z;
+
+    device const float4 * x  = (device const float4 *) (src_x + i03*args.nbf3[0] + i02*args.nbf2[0] + i01*args.nbf1[0]);
+    device const float4 * f0 = (device const float4 *) (src_w);
+    device const float4 * zz = (device const float4 *) (src_z + i03*args.nbf3[1] + i02*args.nbf2[1] + i01*args.nbf1[1]);
+
+    float sumf = 0.0f;
+
+    for (int i00 = tpitg.x; i00 < args.ne00_t; i00 += ntg.x) {
+        sumf += dot(x[i00], x[i00]);
+    }
+    sumf = simd_sum(sumf);
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    if (tiisg == 0) {
+        shmem_f32[sgitg] = sumf;
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    sumf = shmem_f32[tiisg];
+    sumf = simd_sum(sumf);
+
+    const float mean  = sumf/args.ne00;
+    const float scale = 1.0f/sqrt(mean + args.eps);
+
+    threadgroup float4 * ty = (threadgroup float4 *) (shmem_f32 + 32);
+    threadgroup float4 * ts = ty + 32;
+    for (int i00 = tpitg.x; i00 < args.ne00_t; i00 += ntg.x) {
+        ty[i00] = (x[i00]*scale)*f0[i00];
+        const float4 zv = zz[i00];
+        if (GT == 0) {
+            ts[i00] = (1 / (1 + exp(-zv)));
+        } else {
+            ts[i00] = (zv / (1 + exp(-zv)));
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    device float4 * y = (device float4 *) (dst + i03*args.nb3 + i02*args.nb2 + i01*args.nb1);
+    for (int i00 = tpitg.x; i00 < args.ne00_t; i00 += ntg.x) {
+        y[i00] = ty[i00] * ts[i00];
+    }
+}
+
+typedef decltype(kernel_rms_norm_gated_impl<0>) kernel_rms_norm_gated_t;
+
+template [[host_name("kernel_rms_norm_gated_sigmoid_f32_4")]] kernel kernel_rms_norm_gated_t kernel_rms_norm_gated_impl<0>;
+template [[host_name("kernel_rms_norm_gated_silu_f32_4")]]    kernel kernel_rms_norm_gated_t kernel_rms_norm_gated_impl<1>;
+
 template <typename T0, typename T>
 kernel void kernel_l2_norm_impl(
         constant ggml_metal_kargs_l2_norm & args,
