+    uint64_t q_nb1;         // raw q view: bytes per k-head
+    uint64_t q_nb3;         // raw q view: bytes per seq
+    uint64_t k_nb1;
+    uint64_t k_nb3;
+} ggml_metal_kargs_gdn_prep;
+
 typedef struct {
     int32_t  ne00;
     int32_t  ne01;
