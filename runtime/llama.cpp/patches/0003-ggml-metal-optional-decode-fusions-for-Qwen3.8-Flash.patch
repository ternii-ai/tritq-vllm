 ggml/src/ggml-metal/ggml-metal-device.h       |   1 +
 ggml/src/ggml-metal/ggml-metal-impl.h         |  14 +
 ggml/src/ggml-metal/ggml-metal-ops.cpp        | 277 +++++++++++++++++-
