diff --git a/ggml/src/ggml-metal/ggml-metal-context.m b/ggml/src/ggml-metal/ggml-metal-context.m
index 46007fcac..dec173e3e 100644
--- a/ggml/src/ggml-metal/ggml-metal-context.m
+++ b/ggml/src/ggml-metal/ggml-metal-context.m
@@ -93,6 +93,179 @@
 static uint64_t g_moe_done_last = 0; // value signalled at the end of the last encoded graph_compute
 static uint64_t g_moe_go_last   = 0;
 
+// ---- (profiling) GGML_METAL_OPPROF=1: per command buffer GPU busy/idle in decode; =2: also per-op GPU time ----
+#include <os/lock.h>
+#include <mach/mach_time.h>
+#include <pthread.h>
+#include <unistd.h>
+#define PROF_RING   4096
+#define PROF_NSB    16
+#define PROF_SAMP   2048
+#define PROF_MAXL   160
+typedef struct { double commit, go_t, gs, ge; int decode, last, done, nsamp, sb; uint64_t go_v; int lab[PROF_SAMP/2]; } prof_rec_t;
+static int           g_prof = -1;
+static os_unfair_lock g_prof_lock = OS_UNFAIR_LOCK_INIT;
+static prof_rec_t    g_prof_rec[PROF_RING];
+static long          g_prof_seq = 0, g_prof_next = 0;
+static double        g_prof_go_t[PROF_RING];
+static double        g_prof_prev_ge = 0;
+static long          g_prof_tok = 0, g_prof_cbs = 0;
+static double        g_prof_opsum = 0;
+static double        g_prof_busy = 0, g_prof_busy_after_go = 0, g_prof_gap = 0, g_prof_gap_cpu = 0, g_prof_gap_go = 0, g_prof_gap_rest = 0, g_prof_inwait = 0, g_prof_wall = 0, g_prof_t0 = 0;
+static void *        g_prof_sb[PROF_NSB];
+static id<MTLCommandBuffer> g_prof_sb_cb[PROF_NSB];
+static int           g_prof_sb_i = 0;
+static char          g_prof_lab_name[PROF_MAXL][64];
+static double        g_prof_lab_us[PROF_MAXL];
+static long          g_prof_lab_cnt[PROF_MAXL];
+static int           g_prof_nlab = 0;
+static double prof_now(void) { // host time in seconds, the time base of GPUStartTime / GPUEndTime
+    static mach_timebase_info_data_t tb = {0, 0};
+    if (tb.denom == 0) mach_timebase_info(&tb);
+    return (double) mach_absolute_time() * tb.numer / tb.denom * 1e-9;
+}
+static int prof_mode(void) { if (g_prof < 0) { const char * v = getenv("GGML_METAL_OPPROF"); g_prof = v ? atoi(v) : 0; } return g_prof; }
+static int prof_label(const char * s) {
+    for (int i = 0; i < g_prof_nlab; ++i) if (strcmp(g_prof_lab_name[i], s) == 0) return i;
+    if (g_prof_nlab >= PROF_MAXL) return PROF_MAXL - 1;
+    snprintf(g_prof_lab_name[g_prof_nlab], 64, "%s", s);
+    return g_prof_nlab++;
+}
+static void prof_report(void) {
+    const double n = (double) g_prof_tok; if (n <= 0) return;
+    fprintf(stderr, "[opprof] mode %d tokens %ld cbs/token %.1f | per token ms: wall %.2f busy %.2f (after go %.2f, in go-wait %.2f) gaps %.2f = cpu-late %.2f + go-late %.2f + other %.2f\n",
+        g_prof, g_prof_tok, g_prof_cbs/n, 1e3*g_prof_wall/n, 1e3*g_prof_busy/n, 1e3*g_prof_busy_after_go/n, 1e3*g_prof_inwait/n, 1e3*g_prof_gap/n, 1e3*g_prof_gap_cpu/n, 1e3*g_prof_gap_go/n, 1e3*g_prof_gap_rest/n);
+    if (g_prof >= 2) {
+        int ord[PROF_MAXL]; for (int i = 0; i < g_prof_nlab; ++i) ord[i] = i;
+        for (int i = 0; i < g_prof_nlab; ++i) for (int j = i+1; j < g_prof_nlab; ++j) if (g_prof_lab_us[ord[j]] > g_prof_lab_us[ord[i]]) { int t = ord[i]; ord[i] = ord[j]; ord[j] = t; }
+        double tot = 0; for (int i = 0; i < g_prof_nlab; ++i) tot += g_prof_lab_us[i];
+        fprintf(stderr, "[opprof]   ops total %.2f ms/token (sampled cbs %.2f)\n", tot/n/1e3, g_prof_opsum/n/1e3);
+        for (int k = 0; k < g_prof_nlab; ++k) { const int i = ord[k];
+            fprintf(stderr, "[opprof]   %-44s %8.1f us/token  %6.1f /token  %6.2f us each\n", g_prof_lab_name[i], g_prof_lab_us[i]/n, g_prof_lab_cnt[i]/n, g_prof_lab_us[i]/(g_prof_lab_cnt[i] ? g_prof_lab_cnt[i] : 1)); }
+    }
+}
+static void prof_advance(void) { // under lock: consume completed records in submission order
+    while (g_prof_next < g_prof_seq && g_prof_rec[g_prof_next % PROF_RING].done) {
+        prof_rec_t * r = &g_prof_rec[g_prof_next % PROF_RING];
+        if (r->decode) {
+            const double gs = r->gs, ge = r->ge;
+            if (g_prof_t0 == 0) g_prof_t0 = gs;
+            g_prof_cbs++;
+            g_prof_busy += ge - gs;
+            const double go = r->go_v ? r->go_t : 0;
+            g_prof_busy_after_go += ge - (go > gs ? go : gs);
+            if (go > gs) g_prof_inwait += (go < ge ? go : ge) - gs;
+            if (g_prof_prev_ge > 0 && gs > g_prof_prev_ge && gs - g_prof_prev_ge < 1.0) {
+                const double gap = gs - g_prof_prev_ge;
+                double cpu = r->commit - g_prof_prev_ge; if (cpu < 0) cpu = 0; if (cpu > gap) cpu = gap;
+                const double base = g_prof_prev_ge > r->commit ? g_prof_prev_ge : r->commit;
+                double gol = go - base; if (gol < 0) gol = 0; if (gol > gap - cpu) gol = gap - cpu;
+                g_prof_gap += gap; g_prof_gap_cpu += cpu; g_prof_gap_go += gol; g_prof_gap_rest += gap - cpu - gol;
+            }
+            g_prof_prev_ge = ge;
+            if (r->last) {
+                g_prof_tok++;
+                g_prof_wall = ge - g_prof_t0;
+                if (g_prof_tok % 512 == 0) prof_report();
+            }
+        } else {
+            g_prof_prev_ge = 0; // prefill / other work: restart the gap chain
+        }
+        g_prof_next++;
+    }
+}
+// -----------------------------------------------------------------------------------------------
+
+// ---- GGML_METAL_MOE_SPIN=1: while the GPU waits for the expert cache's "go", it spins in a tiny kernel on a shared
+// flag instead of parking on the event, so the GPU does not clock down between layers. The event wait is still
+// encoded right after the spin, so ordering and memory visibility are exactly as without the spin.
+static int g_spin = -1;
+static id<MTLBuffer> g_spin_buf = nil;               // [0] = go value written by the host, [1] = iterations (debug)
+static id<MTLComputePipelineState> g_spin_pso = nil;
+// GGML_METAL_MOE_SPIN=2: a background thread keeps a second command queue busy with a tiny filler kernel while decode is
+// active (an expert-cache mark in the last 50 ms), so the GPU does not clock down while the main queue waits on the event.
+static volatile uint64_t g_fill_last = 0;
+static void * fill_thread(void * arg) {
+    id<MTLDevice> device = (id<MTLDevice>) arg;
+    NSString * src = @"#include <metal_stdlib>\n"
+        "using namespace metal;\n"
+        "kernel void moe_fill(device float * out [[buffer(0)]], constant uint & n [[buffer(1)]], uint tid [[thread_position_in_grid]]) {\n"
+        "    float a = (float) tid;\n"
+        "    for (uint i = 0; i < n; ++i) { a = fma(a, 1.0000001f, 0.5f); }\n"
+        "    out[tid & 63] = a;\n"
+        "}\n";
+    NSError * err = nil;
+    id<MTLLibrary> lib = [device newLibraryWithSource:src options:nil error:&err];
+    if (!lib) { GGML_ABORT("moe_fill: %s", [[err description] UTF8String]); }
+    id<MTLFunction> fn = [lib newFunctionWithName:@"moe_fill"];
+    id<MTLComputePipelineState> pso = [device newComputePipelineStateWithFunction:fn error:&err];
+    id<MTLCommandQueue> q = [device newCommandQueue];
+    id<MTLBuffer> buf = [device newBufferWithLength:256 options:MTLResourceStorageModeShared];
+    const char * ns = getenv("GGML_METAL_MOE_FILL_N");
+    const uint32_t n = ns ? (uint32_t) atoi(ns) : 100000;
+    const char * gs = getenv("GGML_METAL_MOE_FILL_GAP_US"); // idle gap after each dispatch: duty-cycles the filler
+    const useconds_t gap = gs ? (useconds_t) atoi(gs) : 0;
+    mach_timebase_info_data_t tb; mach_timebase_info(&tb);
+    const uint64_t win = (uint64_t) (50e6 * tb.denom / tb.numer); // 50 ms in ticks
+    id<MTLCommandBuffer> inflight[2] = { nil, nil };
+    int k = 0;
+    long n_fill = 0;
+    for (;;) {
+        @autoreleasepool {
+            if (mach_absolute_time() - g_fill_last < win) {
+                if (inflight[k]) { [inflight[k] waitUntilCompleted]; [inflight[k] release]; inflight[k] = nil; }
+                id<MTLCommandBuffer> cb = [q commandBuffer];
+                id<MTLComputeCommandEncoder> enc = [cb computeCommandEncoder];
+                [enc setComputePipelineState:pso];
+                [enc setBuffer:buf offset:0 atIndex:0];
+                [enc setBytes:&n length:sizeof(n) atIndex:1];
+                [enc dispatchThreads:MTLSizeMake(32, 1, 1) threadsPerThreadgroup:MTLSizeMake(32, 1, 1)];
+                [enc endEncoding];
+                [cb commit];
+                inflight[k] = [cb retain];
+                k ^= 1;
+                if (++n_fill % 100000 == 0) GGML_LOG_INFO("%s: %ld filler dispatches\n", __func__, n_fill);
+                if (gap > 0) usleep(gap);
+            } else {
+                usleep(1000);
+            }
+        }
+    }
+    return NULL;
+}
+static void fill_start(ggml_metal_device_t dev) {
+    static int started = 0;
+    if (started) return;
+    started = 1;
+    pthread_t th;
+    pthread_create(&th, NULL, fill_thread, (void *) ggml_metal_device_get_obj(dev));
+    pthread_detach(th);
+    GGML_LOG_INFO("%s: GPU keep-busy filler queue enabled\n", __func__);
+}
+static int spin_mode(void) { if (g_spin < 0) { const char * v = getenv("GGML_METAL_MOE_SPIN"); g_spin = v ? atoi(v) : 2; } /* filler on by default: it only runs while the expert cache is active */ return g_spin; }
+static void spin_init(ggml_metal_device_t dev) {
+    if (g_spin_pso) return;
+    id<MTLDevice> device = (id<MTLDevice>) ggml_metal_device_get_obj(dev);
+    NSString * src = @"#include <metal_stdlib>\n"
+        "using namespace metal;\n"
+        "kernel void moe_spin(device atomic_uint * flag [[buffer(0)]], constant uint & want [[buffer(1)]], uint tid [[thread_position_in_grid]]) {\n"
+        "    if (tid != 0) return;\n"
+        "    uint n = 0;\n"
+        "    while ((int) (atomic_load_explicit(&flag[0], memory_order_relaxed) - want) < 0 && n < 50000000u) { n++; }\n"
+        "    atomic_store_explicit(&flag[1], n, memory_order_relaxed);\n"
+        "}\n";
+    NSError * err = nil;
+    id<MTLLibrary> lib = [device newLibraryWithSource:src options:nil error:&err];
+    if (!lib) { GGML_ABORT("moe_spin: %s", [[err description] UTF8String]); }
+    id<MTLFunction> fn = [lib newFunctionWithName:@"moe_spin"];
+    g_spin_pso = [device newComputePipelineStateWithFunction:fn error:&err];
+    if (!g_spin_pso) { GGML_ABORT("moe_spin pso: %s", [[err description] UTF8String]); }
+    g_spin_buf = [device newBufferWithLength:64 options:MTLResourceStorageModeShared];
+    memset([g_spin_buf contents], 0, 64);
+    [fn release]; [lib release];
+    GGML_LOG_INFO("%s: GPU spin-wait for the MoE go signal enabled\n", __func__);
+}
+
 ggml_metal_t ggml_metal_init(ggml_metal_device_t dev) {
     GGML_LOG_INFO("%s: allocating\n", __func__);
 
@@ -202,6 +375,7 @@ ggml_metal_t ggml_metal_init(ggml_metal_device_t dev) {
 }
 
 void ggml_metal_free(ggml_metal_t ctx) {
+    if (prof_mode() > 0) { os_unfair_lock_lock(&g_prof_lock); prof_report(); os_unfair_lock_unlock(&g_prof_lock); }
     GGML_LOG_INFO("%s: deallocating\n", __func__);
 
     for (int i = 0; i < GGML_METAL_MAX_COMMAND_BUFFERS; ++i) {
@@ -711,6 +885,7 @@ void ggml_metal_event_wait(ggml_metal_t ctx, ggml_metal_event_t ev) {
 }
 
 void ggml_metal_moe_mark(ggml_metal_t ctx, uint64_t * v_done, uint64_t * v_go) {
+    if (spin_mode() == 2) { fill_start(ctx->dev); g_fill_last = mach_absolute_time(); }
     if (!g_moe_inbuf) {
         id<MTLDevice> device = (id<MTLDevice>) ggml_metal_device_get_obj(ctx->dev);
         g_moe_done_ev = [device newSharedEvent];
@@ -744,6 +919,8 @@ void ggml_metal_moe_inbuf_host_wait(uint64_t value, int spin) {
 
 void ggml_metal_moe_inbuf_host_signal(uint64_t value) {
     @autoreleasepool {
+        if (prof_mode() > 0) { g_prof_go_t[value % PROF_RING] = prof_now(); }
+        if (spin_mode() == 1 && g_spin_buf) { __atomic_store_n((uint32_t *) [g_spin_buf contents], (uint32_t) value, __ATOMIC_RELEASE); }
         g_moe_go_ev.signaledValue = value;
     }
 }
@@ -852,11 +1029,61 @@ void ggml_metal_set_n_cb(ggml_metal_t ctx, int n_cb) {
         id<MTLCommandBuffer> cmd_buf = ctx->cmd_bufs[cb_idx].obj;
 
         const bool moe_inbuf = g_moe_inbuf && cb_idx == n_cb_l; // n_cb is 0 in this mode: the only command buffer
+        uint64_t prof_go_v = 0;
         if (moe_inbuf && g_moe_pending_go != 0) {
+            prof_go_v = g_moe_pending_go;
+            if (spin_mode() == 1) {
+                spin_init(ctx->dev);
+                const uint32_t want = (uint32_t) g_moe_pending_go;
+                id<MTLComputeCommandEncoder> enc = [cmd_buf computeCommandEncoder];
+                [enc setComputePipelineState:g_spin_pso];
+                [enc setBuffer:g_spin_buf offset:0 atIndex:0];
+                [enc setBytes:&want length:sizeof(want) atIndex:1];
+                [enc dispatchThreads:MTLSizeMake(1, 1, 1) threadsPerThreadgroup:MTLSizeMake(1, 1, 1)];
+                [enc endEncoding];
+            }
             [cmd_buf encodeWaitForEvent:g_moe_go_ev value:g_moe_pending_go];
             g_moe_pending_go = 0;
         }
 
+        // (profiling) decode = the graph carries one token (HC streams x tokens <= 4 on the first nodes)
+        const int pm = cb_idx == n_cb_l ? prof_mode() : 0;
+        prof_rec_t * pr = NULL;
+        long pseq = -1;
+        void * psb = NULL;
+        if (pm > 0) {
+            // token count from the router logits [n_expert, n_tokens] of this split; a split without a router
+            // inherits the previous split's class; "ffn_moe_logits-0" starts a new token
+            static int dec_prev = 0;
+            int dec = dec_prev, last = 0;
+            for (int i = 0; i < ctx->gf->n_nodes; ++i) {
+                const struct ggml_tensor * t = ctx->gf->nodes[i];
+                if (strncmp(t->name, "ffn_moe_logits-", 15) == 0) {
+                    dec = t->ne[1] == 1;
+                    if (strcmp(t->name, "ffn_moe_logits-0") == 0) last = 1;
+                    break;
+                }
+            }
+            dec_prev = dec;
+            os_unfair_lock_lock(&g_prof_lock);
+            pseq = g_prof_seq++;
+            pr = &g_prof_rec[pseq % PROF_RING];
+            memset(pr, 0, offsetof(prof_rec_t, lab));
+            pr->decode = dec;
+            pr->last = last;
+            pr->go_v = prof_go_v;
+            pr->sb = -1;
+            os_unfair_lock_unlock(&g_prof_lock);
+            if (pm >= 2 && dec) {
+                const int s = g_prof_sb_i++ % PROF_NSB;
+                if (!g_prof_sb[s]) g_prof_sb[s] = ggml_metal_prof_create(ctx->dev, PROF_SAMP);
+                if (g_prof_sb_cb[s]) { [g_prof_sb_cb[s] waitUntilCompleted]; [g_prof_sb_cb[s] release]; }
+                g_prof_sb_cb[s] = [cmd_buf retain];
+                psb = g_prof_sb[s];
+                pr->sb = s;
+            }
+        }
+
         ggml_metal_op_t ctx_op = ggml_metal_op_init(
             ctx->dev,
             cmd_buf,
@@ -868,11 +1095,27 @@ void ggml_metal_set_n_cb(ggml_metal_t ctx, int n_cb) {
             ctx->capture_compute == 0,
             ctx->debug_graph);
 
+        int np = 0;
         for (int idx = 0; idx < ggml_metal_op_n_nodes(ctx_op); ++idx) {
+            if (psb && np < PROF_SAMP/2) {
+                ggml_metal_op_begin_sampled(ctx_op, psb, np);
+            }
             const int res = ggml_metal_op_encode(ctx_op, idx);
             if (res == 0) {
                 break;
             }
+            if (psb && np < PROF_SAMP/2) {
+                // label: op + node name without the layer number, + fused count
+                const struct ggml_tensor * t = ggml_metal_op_node_ptr(ctx_op, idx);
+                char nm[40]; snprintf(nm, sizeof(nm), "%s", t->name);
+                for (char * q = nm; *q; ++q) { if (*q >= '0' && *q <= '9') { *q = 0; break; } }
+                char lab[64];
+                if (res > 1) snprintf(lab, sizeof(lab), "%s:%s+%d", ggml_op_name(t->op), nm, res);
+                else         snprintf(lab, sizeof(lab), "%s:%s", ggml_op_name(t->op), nm);
+                os_unfair_lock_lock(&g_prof_lock);
+                pr->lab[np++] = prof_label(lab);
+                os_unfair_lock_unlock(&g_prof_lock);
+            }
 
             idx += res - 1;
         }
@@ -883,6 +1126,39 @@ void ggml_metal_set_n_cb(ggml_metal_t ctx, int n_cb) {
             [cmd_buf encodeSignalEvent:g_moe_done_ev value:++g_moe_done_last];
         }
 
+        if (pr) {
+            pr->nsamp = np;
+            const long seq = pseq;
+            [cmd_buf addCompletedHandler:^(id<MTLCommandBuffer> cb) {
+                os_unfair_lock_lock(&g_prof_lock);
+                prof_rec_t * r = &g_prof_rec[seq % PROF_RING];
+                r->gs = [cb GPUStartTime];
+                r->ge = [cb GPUEndTime];
+                if (r->go_v) r->go_t = g_prof_go_t[r->go_v % PROF_RING];
+                if (r->sb >= 0 && r->nsamp > 0) {
+                    static uint64_t ts[PROF_SAMP];
+                    const int n = r->nsamp;
+                    const int m = ggml_metal_prof_resolve(g_prof_sb[r->sb], 2*n, ts);
+                    if (m >= 2*n) {
+                        double sum = 0;
+                        for (int i = 0; i < n; ++i) {
+                            const uint64_t a = ts[2*i], b = ts[2*i + 1];
+                            if (a == 0 || b == 0 || a == ~0ULL || b == ~0ULL || b < a) continue;
+                            const double us = (double) (b - a) * 1e-3; // GPU timestamps are ns
+                            g_prof_lab_us[r->lab[i]]  += us;
+                            g_prof_lab_cnt[r->lab[i]] += 1;
+                            sum += us;
+                        }
+                        g_prof_opsum += sum;
+                    }
+                }
+                r->done = 1;
+                prof_advance();
+                os_unfair_lock_unlock(&g_prof_lock);
+            }];
+            pr->commit = prof_now();
+        }
+
         if (cb_idx < 2 || ctx->abort_callback == NULL) {
             [cmd_buf commit];
         }
diff --git a/ggml/src/ggml-metal/ggml-metal-device.cpp b/ggml/src/ggml-metal/ggml-metal-device.cpp
index 0942097d7..4c37f4c02 100644
--- a/ggml/src/ggml-metal/ggml-metal-device.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-device.cpp
@@ -1405,8 +1405,8 @@ ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_mul_mv_id(ggml_m
         case GGML_TYPE_TQ27_128:
