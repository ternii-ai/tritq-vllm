+// (profiling, GGML_METAL_OPPROF) per-encoder GPU timestamps at stage boundaries
+void * ggml_metal_prof_create(ggml_metal_device_t dev, int n) {
+    id<MTLDevice> device = ggml_metal_device_get_obj(dev);
+    if (![device supportsCounterSampling:MTLCounterSamplingPointAtStageBoundary]) {
+        GGML_LOG_ERROR("%s: stage-boundary counter sampling not supported\n", __func__);
+        return NULL;
+    }
+    id<MTLCounterSet> ts = nil;
+    for (id<MTLCounterSet> cs in device.counterSets) {
+        if ([cs.name isEqualToString:MTLCommonCounterSetTimestamp]) ts = cs;
+    }
+    if (!ts) return NULL;
+    MTLCounterSampleBufferDescriptor * d = [[MTLCounterSampleBufferDescriptor alloc] init];
+    d.counterSet = ts;
+    d.storageMode = MTLStorageModeShared;
+    d.sampleCount = n;
+    NSError * err = nil;
+    id<MTLCounterSampleBuffer> sb = [device newCounterSampleBufferWithDescriptor:d error:&err];
+    [d release];
+    if (!sb) { GGML_LOG_ERROR("%s: %s\n", __func__, [[err description] UTF8String]); return NULL; }
+    return (void *) sb;
+}
+
+ggml_metal_encoder_t ggml_metal_encoder_init_sampled(ggml_metal_cmd_buf_t cmd_buf_raw, bool concurrent, void * sbuf, int i) {
+    ggml_metal_encoder_t res = calloc(1, sizeof(struct ggml_metal_encoder));
+    id<MTLCommandBuffer> cmd_buf = (id<MTLCommandBuffer>) cmd_buf_raw;
+    MTLComputePassDescriptor * pd = [MTLComputePassDescriptor computePassDescriptor];
+    pd.dispatchType = concurrent ? MTLDispatchTypeConcurrent : MTLDispatchTypeSerial;
+    pd.sampleBufferAttachments[0].sampleBuffer = (id<MTLCounterSampleBuffer>) sbuf;
+    pd.sampleBufferAttachments[0].startOfEncoderSampleIndex = 2*i;
+    pd.sampleBufferAttachments[0].endOfEncoderSampleIndex   = 2*i + 1;
+    res->obj = [cmd_buf computeCommandEncoderWithDescriptor:pd];
+    [res->obj retain];
+    return res;
+}
+
+int ggml_metal_prof_resolve(void * sbuf, int n, uint64_t * out) {
+    id<MTLCounterSampleBuffer> sb = (id<MTLCounterSampleBuffer>) sbuf;
+    NSData * data = [sb resolveCounterRange:NSMakeRange(0, n)];
+    if (!data) return 0;
+    const MTLCounterResultTimestamp * ts = (const MTLCounterResultTimestamp *) data.bytes;
+    const int m = (int) (data.length / sizeof(MTLCounterResultTimestamp));
+    for (int k = 0; k < m && k < n; ++k) out[k] = ts[k].timestamp;
+    return m;
+}
