 ggml/src/ggml-metal/ggml-metal-device.m   |  46 +++
 ggml/src/ggml-metal/ggml-metal-impl.h     |   8 +
 ggml/src/ggml-metal/ggml-metal-ops.cpp    |  11 +
 ggml/src/ggml-metal/ggml-metal-ops.h      |   4 +
 ggml/src/ggml-metal/kernels/mul_mm.metal  |   1 +
 ggml/src/ggml-metal/kernels/mul_mv.metal  |   6 +-
 src/llama-context.cpp                     |  20 ++
 src/llama-model.cpp                       |  25 ++
 src/llama-model.h                         |   1 +
