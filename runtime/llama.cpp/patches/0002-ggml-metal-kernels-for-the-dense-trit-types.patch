-    snprintf(base, 256, "kernel_mul_mm_%s_%s", ggml_type_name(tsrc0), ggml_type_name(tsrc1));
+    // TQ: native dense-trit tile (K = 128 per stage) on the tensor-API path, opt-in GGML_METAL_TQD_MM=1
+    static const bool tqd_mm = getenv("GGML_METAL_TQD_MM") != nullptr;
