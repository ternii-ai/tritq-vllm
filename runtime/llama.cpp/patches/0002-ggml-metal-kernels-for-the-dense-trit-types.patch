diff --git a/ggml/src/ggml-cpu/quants.c b/ggml/src/ggml-cpu/quants.c
index 0b3cb71..0e8d28a 100644
--- a/ggml/src/ggml-cpu/quants.c
+++ b/ggml/src/ggml-cpu/quants.c
@@ -394,6 +394,55 @@ TQD_VEC_DOT(tq9_128,  TQ9_N,  TQ9_W)
 TQD_VEC_DOT(tq27_128, TQ27_N, TQ27_W)
 TQD_VEC_DOT(tq81_128, TQ81_N, TQ81_W)
 
+// TQ: Q8_0 activations for the TQ types. The Q8_K pairing above needs n % 256 == 0: for K = 640 (the 125B's expert / shared
+// down_proj) quantize_row_q8_K covers only 512 inputs and the dot silently drops the last 128. Q8_0 (32-wide) works for any n % 128 == 0:
+// decode the block's 128 digits once, then one integer dot per 32-subblock with its own Q8_0 scale.
+static inline void tqd_block_digits(const uint8_t * GGML_RESTRICT b, uint8_t * GGML_RESTRICT u, const int N, const int W) {
+    const uint16_t * lo = (const uint16_t *) (b + 2);
+    const uint8_t  * h8 = b + 2 + 2*TQD_NW;
+    const uint16_t * h16 = (const uint16_t *) (b + 2 + 2*TQD_NW);
+    const uint64_t mask = (W >= 32) ? 0xFFFFFFFFull : ((1ull << W) - 1);
+    for (int w = 0; w < TQD_NW; w++) {
+        uint64_t t = lo[w] | (W == 24 ? ((uint64_t) h8[w] << 16) : 0) | (W == 32 ? ((uint64_t) h16[w] << 16) : 0);
+        for (int i = 0; i < 5; i++) {
+            t *= (uint64_t) N;
+            const int j = i*TQD_NW + w;
+            if (j < QK_TQD) u[j] = (uint8_t)(t >> W);
+            t &= mask;
+        }
+    }
+}
+
+#define TQD_VEC_DOT_Q8_0(name, NLEV, WB)                                                                           \
+void ggml_vec_dot_##name##_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, \
+        const void * GGML_RESTRICT vy, size_t by, int nrc) {                                                       \
+    assert(n % QK_TQD == 0);                                                                                       \
+    assert(nrc == 1);                                                                                              \
+    UNUSED(nrc); UNUSED(bx); UNUSED(by); UNUSED(bs);                                                               \
+    const block_##name * GGML_RESTRICT x = (const block_##name *) vx;                                              \
+    const block_q8_0   * GGML_RESTRICT y = (const block_q8_0 *) vy;                                                \
+    const int L  = (NLEV - 1)/2;                                                                                   \
+    const int nb = n / QK_TQD;                                                                                     \
+    uint8_t u[QK_TQD];                                                                                             \
+    float sumf = 0.0f;                                                                                             \
+    for (int ib = 0; ib < nb; ib++) {                                                                              \
+        tqd_block_digits((const uint8_t *) &x[ib], u, NLEV, WB);                                                   \
+        float part = 0.0f;                                                                                         \
+        for (int k = 0; k < QK_TQD/QK8_0; k++) {                                                                   \
+            const block_q8_0 * yb = &y[ib*(QK_TQD/QK8_0) + k];                                                     \
+            int32_t isum = 0, bsum = 0;                                                                            \
+            for (int j = 0; j < QK8_0; j++) { isum += (int32_t) u[k*QK8_0 + j] * yb->qs[j]; bsum += yb->qs[j]; }   \
+            part += GGML_CPU_FP16_TO_FP32(yb->d) * (float)(isum - L*bsum);                                         \
+        }                                                                                                          \
+        sumf += GGML_CPU_FP16_TO_FP32(x[ib].d) * part;                                                             \
+    }                                                                                                              \
+    *s = sumf;                                                                                                     \
+}
+
+TQD_VEC_DOT_Q8_0(tq9_128,  TQ9_N,  TQ9_W)
+TQD_VEC_DOT_Q8_0(tq27_128, TQ27_N, TQ27_W)
+TQD_VEC_DOT_Q8_0(tq81_128, TQ81_N, TQ81_W)
+
 void ggml_vec_dot_q4_0_q8_0_generic(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
     const int qk = QK8_0;
     const int nb = n / qk;
