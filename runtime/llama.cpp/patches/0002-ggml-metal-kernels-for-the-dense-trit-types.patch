         res.smem = smem_a;
     } else {
         res.nr0 = 64;
@@ -1032,6 +1037,13 @@ ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_mul_mv(ggml_meta
                 nsg = N_SG_Q2_0;
                 nr0 = N_R0_Q2_0;
