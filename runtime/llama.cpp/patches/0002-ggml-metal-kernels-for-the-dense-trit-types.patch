+// Dense trit mat-vec. The row's nb*26 words are spread flat over the 32 lanes (all lanes busy even though
+// 26 does not divide 32). A lane's word w of block ib covers weights ib*128 + w + 26*i (i = 0..4), the same
+// columns for every row, so the 5 activations (and their sum, which folds the -(N-1)/2 offset) are loaded
+// once and reused across the nr0 rows. Decode is 1 multiply + shift + mask per weight (W = 32: mulhi + mul).
+#define TQD_WPL 2   // words per lane; the pair loader tqd_word2 below is written for exactly 2
+template<typename block_t, int NLEV, int WB, int nr0, typename args_t>
+void kernel_mul_mv_tqd_f32_impl(
+        args_t args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem,
+        uint3  tgpig,
+        ushort tiisg,
+        ushort sgitg) {
+    const short NSG = FC_mul_mv_nsg;
+
+    const int nb = args.ne00/QK_TQD;
+    const int nw = nb*TQD_NW;
+
+    const int r0 = tgpig.x;
+    const int r1 = tgpig.y;
+    const int im = tgpig.z;
+
+    const int first_row = (r0 * NSG + sgitg) * nr0;
+
+    const uint i12 = im%args.ne12;
+    const uint i13 = im/args.ne12;
+
+    const uint64_t offset1 = r1*args.nb11 + (i12)*args.nb12 + (i13)*args.nb13;
+
+    device const float * y = (device const float *) (src1 + offset1);
+
+    device const block_t * ax[nr0];
+    for (int row = 0; row < nr0; ++row) {
+        const int rr = min(first_row + row, args.ne01 - 1);
+        const uint64_t offset0 = rr*args.nb01 + (i12/args.r2)*args.nb02 + (i13/args.r3)*args.nb03;
+        ax[row] = (device const block_t *) ((device char *) src0 + offset0);
+    }
+
+    const float off  = float((NLEV - 1)/2);
+    const uint  mask = WB < 32 ? ((1u << (WB & 31)) - 1u) : 0xFFFFFFFFu;
+
+    constexpr short WPL = TQD_WPL;                 // consecutive words per lane
+    constexpr short GPB = TQD_NW/WPL;              // lane-groups per block
+    const int ng = nb*GPB;
+
+    float sumf[nr0] = {0.f};
+
+    for (int g = tiisg; g < ng; g += N_SIMDWIDTH) {
+        const int   ib = g / GPB;
+        const short w0 = (g - ib*GPB)*WPL;
+
+        device const float * yb = y + ib*QK_TQD + w0;
+        float yv[WPL][5];
+        float sy = 0.f;
+        FOR_UNROLL (short k = 0; k < WPL; ++k) {
+            FOR_UNROLL (short i = 0; i < 4; ++i) { yv[k][i] = yb[k + i*TQD_NW]; }
+            yv[k][4] = (w0 + k) < QK_TQD - 4*TQD_NW ? yb[k + 4*TQD_NW] : 0.f;
+            sy += yv[k][0] + yv[k][1] + yv[k][2] + yv[k][3] + yv[k][4];
+        }
+        sy *= off;
+
+        FOR_UNROLL (short row = 0; row < nr0; ++row) {
+            device const block_t * xb = ax[row] + ib;
+            float acc = 0.f;
+            uint tw[2];
+            tqd_word2(xb, w0, tw[0], tw[1]);
+            FOR_UNROLL (short k = 0; k < WPL; ++k) {
+                uint t = tw[k];
+                FOR_UNROLL (short i = 0; i < 5; ++i) {
+                    uint u;
+                    if (WB < 32) {
+                        t *= uint(NLEV);
+                        u  = t >> (WB & 31);
+                        t &= mask;
+                    } else {
+                        u  = mulhi(t, uint(NLEV));
+                        t *= uint(NLEV);
+                    }
+                    acc += float(u)*yv[k][i];
+                }
+            }
+            sumf[row] += (acc - sy)*float(xb->d);
+        }
+    }
+
+    device float * dst_f32 = (device float *) dst + (uint64_t)im*args.ne0*args.ne1 + (uint64_t)r1*args.ne0;
+
+    for (int row = 0; row < nr0; ++row) {
+        const float tot = simd_sum(sumf[row]);
+
+        if (tiisg == 0 && first_row + row < args.ne01) {
+            dst_f32[first_row + row] = tot;
+        }
+    }
+}
