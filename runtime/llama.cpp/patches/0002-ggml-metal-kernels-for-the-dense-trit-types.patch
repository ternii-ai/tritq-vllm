diff --git a/ggml/src/ggml-metal/ggml-metal-impl.h b/ggml/src/ggml-metal/ggml-metal-impl.h
index 4ffb5a7..ba7b0b1 100644
--- a/ggml/src/ggml-metal/ggml-metal-impl.h
+++ b/ggml/src/ggml-metal/ggml-metal-impl.h
@@ -29,6 +29,14 @@
 #define N_R0_Q2_0 8
 #define N_SG_Q2_0 2
 
+// dense trit TQ*_128 mat-vec occupancy (M5 Max sweep: (2,2) best for TQ27)
+#ifndef N_R0_TQD
+#define N_R0_TQD 2
+#endif
+#ifndef N_SG_TQD
+#define N_SG_TQD 2
+#endif
+
 #define N_R0_Q4_0 4
 #define N_SG_Q4_0 2
 
diff --git a/ggml/src/ggml-metal/kernels/dequantize.h b/ggml/src/ggml-metal/kernels/dequantize.h
index 54e00fa..a12f106 100644
--- a/ggml/src/ggml-metal/kernels/dequantize.h
+++ b/ggml/src/ggml-metal/kernels/dequantize.h
@@ -737,3 +737,57 @@ void dequantize_tq2_0(device const block_tq2_0 * xb, short il, thread type4x4 &
 
     reg = (type4x4) reg_f;
 }
+
+// ===== Dense trit TQ*_128 (format: ggml-common.h) =====
+inline uint tqd_word(device const block_tq9_128  * b, int w) { return uint(b->lo[w]); }
+inline uint tqd_word(device const block_tq27_128 * b, int w) { return uint(b->lo[w]) | (uint(b->hi[w]) << 16); }
+inline uint tqd_word(device const block_tq81_128 * b, int w) { return uint(b->lo[w]) | (uint(b->hi[w]) << 16); }
+
+// two consecutive words (w0 even) with explicit 2-byte loads only
+inline void tqd_word2(device const block_tq9_128  * b, int w0, thread uint & t0, thread uint & t1) {
+    t0 = uint(b->lo[w0]); t1 = uint(b->lo[w0 + 1]);
+}
+inline void tqd_word2(device const block_tq27_128 * b, int w0, thread uint & t0, thread uint & t1) {
+    const uint h = uint(((device const ushort *) b->hi)[w0/2]);       // hi[w0] | hi[w0+1] << 8 (offset 54 + w0: even)
+    t0 = uint(b->lo[w0])     | ((h & 0xFFu) << 16);
+    t1 = uint(b->lo[w0 + 1]) | ((h >> 8)    << 16);
+}
+inline void tqd_word2(device const block_tq81_128 * b, int w0, thread uint & t0, thread uint & t1) {
+    t0 = uint(b->lo[w0])     | (uint(b->hi[w0])     << 16);
+    t1 = uint(b->lo[w0 + 1]) | (uint(b->hi[w0 + 1]) << 16);
+}
+
+// 16 consecutive weights [il*16, il*16+16) -> reg (used by get_rows and mul_mm dequantise-to-f16).
+// The 16 weights are words w0.. (mod 26) of at most two digit rows i0, i0+1 (16 < 26), so the digit multiplier
+// N^i takes two values, computed once; each weight is then mul + mask + mul + shift (W = 32: mul + mulhi).
+template <typename block_t, int NLEV, int WB, typename type4x4>
+void dequantize_tqd(device const block_t * xb, short il, thread type4x4 & reg) {
+    const float d    = xb->d;
+    const float off  = float((NLEV - 1)/2);
+    const uint  mask = WB < 32 ? ((1u << (WB & 31)) - 1u) : 0xFFFFFFFFu;
+    const short j0 = il*16;
+    const short i0 = j0 / TQD_NW;
+    const short w0 = j0 - i0*TQD_NW;
+    uint p0 = 1;
+    for (short k = 0; k < i0; ++k) p0 *= uint(NLEV);
+    const uint p1 = p0*uint(NLEV);
+    float4x4 reg_f;
+    FOR_UNROLL (short k = 0; k < 16; ++k) {
+        const short wk   = w0 + k;
+        const bool  wrap = wk >= TQD_NW;
+        const uint  t    = tqd_word(xb, wrap ? wk - TQD_NW : wk) * (wrap ? p1 : p0);
+        const uint  u    = WB < 32 ? (((t & mask)*uint(NLEV)) >> (WB & 31)) : mulhi(t, uint(NLEV));
+        reg_f[k/4][k%4] = (float(u) - off)*d;
+    }
+    reg = (type4x4) reg_f;
+}
+
+template <typename type4x4>
+void dequantize_tq9_128(device const block_tq9_128 * xb, short il, thread type4x4 & reg) { dequantize_tqd<block_tq9_128, 9, 16>(xb, il, reg); }
+
+template <typename type4x4>
+void dequantize_tq27_128(device const block_tq27_128 * xb, short il, thread type4x4 & reg) { dequantize_tqd<block_tq27_128, 27, 24>(xb, il, reg); }
+
+template <typename type4x4>
+void dequantize_tq81_128(device const block_tq81_128 * xb, short il, thread type4x4 & reg) { dequantize_tqd<block_tq81_128, 81, 32>(xb, il, reg); }
+
diff --git a/ggml/src/ggml-metal/kernels/mul_mm.metal b/ggml/src/ggml-metal/kernels/mul_mm.metal
index dfa5102..5e66b11 100644
--- a/ggml/src/ggml-metal/kernels/mul_mm.metal
+++ b/ggml/src/ggml-metal/kernels/mul_mm.metal
@@ -365,6 +365,109 @@ kernel void kernel_mul_mm(
 
 #endif // GGML_METAL_HAS_TENSOR
 
+
+#ifdef GGML_METAL_HAS_TENSOR
+// TQ: native dense-trit prefill tile (port of the earlier kernel_mul_mm_tqd to upstream's tensor-API kernel layout).
+// The A tile spans one whole TQ block (K = 128); work items load word PAIRS (tqd_word2) and peel 5 digits each (1 mul + shift + mask),
+// storing (u - L)*d as half at natural positions w + 26*i. Same float expression and half cast as dequantize_tqd -> same A values as
+// the generic path. Selected with GGML_METAL_TQD_MM=1 (ggml-metal-device.cpp); K % 128 == 0 always holds for TQ.
+template<typename block_t, int NLEV, int WB, typename T1>
+kernel void kernel_mul_mm_tqd(
+        constant ggml_metal_kargs_mul_mm & args,
+        device const char * srcA,
+        device const char * srcB,
+        device       char * dst,
+        threadgroup  char * shmem [[threadgroup(0)]],
+        uint3  tgpig [[threadgroup_position_in_grid]],
+        ushort tiitg [[thread_index_in_threadgroup]],
+        ushort sgitg [[simdgroup_index_in_threadgroup]]) {
+    (void) sgitg;
+    const int K = args.ne00;
+    const int M = args.ne0;
+    const int N = args.ne1;
+    const int im = tgpig.z;
+    const int i12 = im % FC_mul_mm_ne12;
+    const int i13 = im / FC_mul_mm_ne12;
+    const uint64_t offset0 = (i12/FC_mul_mm_r2)*args.nb02 + (i13/FC_mul_mm_r3)*args.nb03;
+
+    constexpr int NRB = SZ_SIMDGROUP * N_MM_BLOCK_X * N_MM_SIMD_GROUP_X;
+    constexpr int NRA = SZ_SIMDGROUP * N_MM_BLOCK_Y * N_MM_SIMD_GROUP_Y;
+    constexpr int NKT = QK_TQD;
+    constexpr int NUM_THREADS = N_SIMDWIDTH * N_MM_SIMD_GROUP_X * N_MM_SIMD_GROUP_Y;
+
+    const int ra = tgpig.y * NRA;
+    const int rb = tgpig.x * NRB;
+
+    threadgroup half * sa = (threadgroup half *)(shmem);
+
+    device T1 * ptrB = (device T1 *)(srcB + args.nb12*i12 + args.nb13*i13);
+    const int strideB = args.nb11 / sizeof(T1);
+
+    mpp::tensor_ops::matmul2d<
+        mpp::tensor_ops::matmul2d_descriptor(
+            NRB, NRA, static_cast<int>(dynamic_extent), false, true, true,
+            mpp::tensor_ops::matmul2d_descriptor::mode::multiply_accumulate),
+        execution_simdgroups<N_MM_SIMD_GROUP_X * N_MM_SIMD_GROUP_Y>> mm;
+
+    auto tB0 = tensor(ptrB, dextents<int32_t, 2>(K, N), array<int, 2>({1, strideB}));
+    auto tA0 = tensor(sa, dextents<int32_t, 2>(NKT, NRA));
+    auto cT = mm.get_destination_cooperative_tensor<decltype(tB0), decltype(tA0), float>();
+
+    const float off  = float((NLEV - 1)/2);
+    const uint  mask = WB < 32 ? ((1u << (WB & 31)) - 1u) : 0xFFFFFFFFu;
+    const int   nb   = K / QK_TQD;
+
+    for (int ib = 0; ib < nb; ++ib) {
+        for (int work = tiitg; work < NRA*(TQD_NW/2); work += NUM_THREADS) {
+            const int   row = work / (TQD_NW/2);
+            const short w0  = (work - row*(TQD_NW/2))*2;
+            threadgroup half * out = sa + row*NKT + w0;
+            if (ra + row < M) {
+                device const block_t * xb = (device const block_t *)(srcA + args.nb01*(ra + row) + offset0) + ib;
+                const float d = xb->d;
+                uint tw[2];
+                tqd_word2(xb, w0, tw[0], tw[1]);
+                FOR_UNROLL (short k = 0; k < 2; ++k) {
+                    uint t = tw[k];
+                    FOR_UNROLL (short i = 0; i < 5; ++i) {
+                        uint u;
+                        if (WB < 32) { t *= uint(NLEV); u = t >> (WB & 31); t &= mask; }
+                        else         { u = mulhi(t, uint(NLEV)); t *= uint(NLEV); }
+                        if (i < 4 || w0 + k < QK_TQD - 4*TQD_NW) {
+                            out[i*TQD_NW + k] = (half)((float(u) - off)*d);
+                        }
+                    }
+                }
+            } else {
+                FOR_UNROLL (short k = 0; k < 2; ++k) {
+                    FOR_UNROLL (short i = 0; i < 5; ++i) {
+                        if (i < 4 || w0 + k < QK_TQD - 4*TQD_NW) { out[i*TQD_NW + k] = (half) 0; }
+                    }
+                }
+            }
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        auto tAv = tensor(sa, dextents<int32_t, 2>(NKT, NRA), array<int, 2>({1, NKT}));
