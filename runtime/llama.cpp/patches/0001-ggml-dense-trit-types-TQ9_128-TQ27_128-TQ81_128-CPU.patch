+class _TQDense:
+    """Dense trit TQ*_128 (see ggml/src/ggml-common.h): 128 weights = fp16 key d + 26 mixed-radix words.
+    Weight j -> word j % 26, digit j // 26 (digit 0 most significant); digit u = q + (N-1)/2 in [0, N);
+    word x = ceil(v * 2^W / N^5), v = sum_i u_i N^(4-i); stored as lo (uint16) [+ hi (uint8 W=24 / uint16 W=32)]."""
+    N: int
+    W: int
+    NW = 26
+
+    @classmethod
+    def pack_codes(cls, d: np.ndarray, q: np.ndarray) -> np.ndarray:
+        """d: [nb] float16 keys, q: [nb, 128] integer codes in [-(N-1)/2, (N-1)/2] -> uint8 [nb, type_size]."""
+        N, W, NW = cls.N, cls.W, cls.NW
+        L = (N - 1) // 2
+        nb = q.shape[0]
+        q = np.asarray(q, dtype=np.int64)
+        assert q.shape[1] == 128 and int(q.min(initial=0)) >= -L and int(q.max(initial=0)) <= L, "code out of range"
+        u = np.zeros((nb, 5 * NW), dtype=np.uint64)
+        u[:, :128] = (q + L).astype(np.uint64)
+        u = u.reshape(nb, 5, NW)                       # [block, digit, word]
+        v = np.zeros((nb, NW), dtype=np.uint64)
+        for i in range(5):
+            v = v * np.uint64(N) + u[:, i, :]
+        N5 = np.uint64(N ** 5)
+        num = v << np.uint64(W)                        # < 2^64 for every supported (N, W)
+        x = num // N5 + (num % N5 != 0).astype(np.uint64)
+        assert int(x.max(initial=0)) < (1 << W)
+        parts = [np.asarray(d, dtype=np.float16).reshape(nb, 1).view(np.uint8),
+                 (x & np.uint64(0xFFFF)).astype(np.uint16).view(np.uint8)]
+        if W == 24:
+            parts.append((x >> np.uint64(16)).astype(np.uint8))
+        elif W == 32:
+            parts.append((x >> np.uint64(16)).astype(np.uint16).view(np.uint8))
+        return np.concatenate(parts, axis=-1)
+
+    @classmethod
+    def unpack_codes(cls, blocks: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+        N, W, NW = cls.N, cls.W, cls.NW
+        L = (N - 1) // 2
+        nb = blocks.shape[0]
+        d = blocks[:, :2].copy().view(np.float16).reshape(nb)
+        x = blocks[:, 2:2 + 2 * NW].copy().view(np.uint16).astype(np.uint64)
+        if W == 24:
+            x |= blocks[:, 2 + 2 * NW:2 + 3 * NW].astype(np.uint64) << np.uint64(16)
+        elif W == 32:
+            x |= blocks[:, 2 + 2 * NW:2 + 4 * NW].copy().view(np.uint16).astype(np.uint64) << np.uint64(16)
+        mask = np.uint64((1 << W) - 1)
+        q = np.empty((nb, 5, NW), dtype=np.int64)
+        t = x
+        for i in range(5):
+            t = t * np.uint64(N)
+            q[:, i, :] = (t >> np.uint64(W)).astype(np.int64) - L
+            t = t & mask
+        return d, q.reshape(nb, 5 * NW)[:, :128]
+
+    @classmethod
+    def quantize_blocks(cls, blocks: np.ndarray) -> np.ndarray:
+        L = (cls.N - 1) // 2
+        d = (np.abs(blocks).max(axis=-1) / L).astype(np.float16)
+        df = d.astype(np.float32)
+        df[df == 0] = 1.0
+        q = np.clip(np.rint(blocks / df[:, None]), -L, L).astype(np.int64)
+        return cls.pack_codes(d, q)
+
+    @classmethod
+    def dequantize_blocks(cls, blocks: np.ndarray) -> np.ndarray:
+        d, q = cls.unpack_codes(blocks)
+        return d.astype(np.float32)[:, None] * q.astype(np.float32)
+
+
+class TQ9_128(_TQDense, __Quant, qtype=GGMLQuantizationType.TQ9_128):
+    N, W = 9, 16
+
+
+class TQ27_128(_TQDense, __Quant, qtype=GGMLQuantizationType.TQ27_128):
+    N, W = 27, 24
+
+
+class TQ81_128(_TQDense, __Quant, qtype=GGMLQuantizationType.TQ81_128):
+    N, W = 81, 32
+
+
