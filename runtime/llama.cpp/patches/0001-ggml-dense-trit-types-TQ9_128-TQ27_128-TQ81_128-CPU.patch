diff --git a/ggml/src/ggml-cpu/quants.c b/ggml/src/ggml-cpu/quants.c
index 5e36459..0b3cb71 100644
--- a/ggml/src/ggml-cpu/quants.c
+++ b/ggml/src/ggml-cpu/quants.c
@@ -222,6 +222,178 @@ void ggml_vec_dot_q2_0_q8_0_generic(int n, float * GGML_RESTRICT s, size_t bs, c
     *s = sumf;
 }
 
+// ===== Dense trit TQ*_128 x Q8_K (format: ggml-common.h) =====
+// Activations are Q8_K (ONE float scale per 256 = two TQ blocks; bsums per 16), so integer dot products may span any
+// 32-boundary. That lets each digit row i (weights 26i .. 26i+25 = digit i of the 26 words) be dotted DIRECTLY against
+// y[26i .. 26i+31] -- no reordering of codes into natural order, no store/reload. Unsigned digits u (0..N-1) are used
+// as int8 and the offset is removed with the bsums: sum (u - L) y = sum u y - L * sum y.
+// Decode (NEON): words are gathered with vqtbl2 from 6 overlapping 16-byte loads (no overread past the block).
+//  W < 32 (TQ9, TQ27): the word is multiplied by N WITHOUT masking; with B = the byte holding bits [W, W+8) of each
+//    32-bit lane, H_i = B(m_i) satisfies H_i = (N*H_{i-1} + u_i) mod 256, so u_i = H_i - N*H_{i-1} (u8 arithmetic):
+//    per digit row = 7 vmul + 2 vqtbl4 (pick byte B of 28 lanes) + 2 vmls.
+//  W = 32 (TQ81): vmull_u32 / vmull_high_u32, digit = high 32 bits (vuzp2), state = low 32 bits (vuzp1).
+// Requires ne00 % 256 == 0 (Q8_K); true for every Qwen3 dimension (1024, 2048, 2560, 4096, 6144, 9728, 12288, ...).
+#if defined(__ARM_NEON) && defined(__aarch64__)
+static const uint8_t tqd_idx_tq27[7][16] = {   // vqtbl2 {lo-src, hi-src}: word w = [lo lsb, lo msb, hi, 0]
+    { 0, 1,16,255,  2, 3,17,255,  4, 5,18,255,  6, 7,19,255},     // w 0..3   {R0 = b+2,  H0 = b+54}
+    { 8, 9,20,255, 10,11,21,255, 12,13,22,255, 14,15,23,255},     // w 4..7
+    { 0, 1,24,255,  2, 3,25,255,  4, 5,26,255,  6, 7,27,255},     // w 8..11  {R1 = b+18, H0}
+    { 8, 9,28,255, 10,11,29,255, 12,13,30,255, 14,15,31,255},     // w 12..15
+    { 0, 1,22,255,  2, 3,23,255,  4, 5,24,255,  6, 7,25,255},     // w 16..19 {R2 = b+34, H1 = b+64}
+    { 8, 9,26,255, 10,11,27,255, 12,13,28,255, 14,15,29,255},     // w 20..23
+    {12,13,30,255, 14,15,31,255, 255,255,255,255, 255,255,255,255}, // w 24..25 {R3 = b+38, H1}
+};
+static const uint8_t tqd_idx_tq81[7][16] = {   // hi is uint16: word w = [lo lsb, lo msb, hi lsb, hi msb]
+    { 0, 1,16,17,  2, 3,18,19,  4, 5,20,21,  6, 7,22,23},         // w 0..3   {R0 = b+2,  H0 = b+54}
+    { 8, 9,24,25, 10,11,26,27, 12,13,28,29, 14,15,30,31},         // w 4..7
+    { 0, 1,16,17,  2, 3,18,19,  4, 5,20,21,  6, 7,22,23},         // w 8..11  {R1 = b+18, H1 = b+70}
+    { 8, 9,24,25, 10,11,26,27, 12,13,28,29, 14,15,30,31},         // w 12..15
+    { 0, 1,16,17,  2, 3,18,19,  4, 5,20,21,  6, 7,22,23},         // w 16..19 {R2 = b+34, H2 = b+86}
+    { 8, 9,24,25, 10,11,26,27, 12,13,28,29, 14,15,30,31},         // w 20..23
+    {12,13,28,29, 14,15,30,31, 255,255,255,255, 255,255,255,255}, // w 24..25 {R3 = b+38, H3 = b+90}
+};
+static const uint8_t tqd_idx_tq9[7][16] = {    // lo only
+    { 0, 1,255,255,  2, 3,255,255,  4, 5,255,255,  6, 7,255,255}, // R0 = b+2
+    { 8, 9,255,255, 10,11,255,255, 12,13,255,255, 14,15,255,255},
+    { 0, 1,255,255,  2, 3,255,255,  4, 5,255,255,  6, 7,255,255}, // R1 = b+18
+    { 8, 9,255,255, 10,11,255,255, 12,13,255,255, 14,15,255,255},
+    { 0, 1,255,255,  2, 3,255,255,  4, 5,255,255,  6, 7,255,255}, // R2 = b+34
+    { 8, 9,255,255, 10,11,255,255, 12,13,255,255, 14,15,255,255},
+    {12,13,255,255, 14,15,255,255, 255,255,255,255, 255,255,255,255}, // R3 = b+38
+};
+
+static inline __attribute__((always_inline)) uint8x16_t tqd_tbl2(uint8x16_t a, uint8x16_t b, const uint8_t * idx) {
+    uint8x16x2_t t = { { a, b } };
+    return vqtbl2q_u8(t, vld1q_u8(idx));
+}
+
+// words of one block -> 7 x uint32x4 (lanes 26, 27 = 0)
+static inline __attribute__((always_inline)) void tqd_words(const uint8_t * GGML_RESTRICT b, uint32x4_t w[7], const int W) {
+    const uint8x16_t R0 = vld1q_u8(b + 2), R1 = vld1q_u8(b + 18), R2 = vld1q_u8(b + 34), R3 = vld1q_u8(b + 38);
+    if (W == 24) {
+        const uint8x16_t H0 = vld1q_u8(b + 54), H1 = vld1q_u8(b + 64);
+        w[0] = vreinterpretq_u32_u8(tqd_tbl2(R0, H0, tqd_idx_tq27[0])); w[1] = vreinterpretq_u32_u8(tqd_tbl2(R0, H0, tqd_idx_tq27[1]));
+        w[2] = vreinterpretq_u32_u8(tqd_tbl2(R1, H0, tqd_idx_tq27[2])); w[3] = vreinterpretq_u32_u8(tqd_tbl2(R1, H0, tqd_idx_tq27[3]));
+        w[4] = vreinterpretq_u32_u8(tqd_tbl2(R2, H1, tqd_idx_tq27[4])); w[5] = vreinterpretq_u32_u8(tqd_tbl2(R2, H1, tqd_idx_tq27[5]));
+        w[6] = vreinterpretq_u32_u8(tqd_tbl2(R3, H1, tqd_idx_tq27[6]));
+    } else if (W == 32) {
+        const uint8x16_t H0 = vld1q_u8(b + 54), H1 = vld1q_u8(b + 70), H2 = vld1q_u8(b + 86), H3 = vld1q_u8(b + 90);
+        w[0] = vreinterpretq_u32_u8(tqd_tbl2(R0, H0, tqd_idx_tq81[0])); w[1] = vreinterpretq_u32_u8(tqd_tbl2(R0, H0, tqd_idx_tq81[1]));
+        w[2] = vreinterpretq_u32_u8(tqd_tbl2(R1, H1, tqd_idx_tq81[2])); w[3] = vreinterpretq_u32_u8(tqd_tbl2(R1, H1, tqd_idx_tq81[3]));
+        w[4] = vreinterpretq_u32_u8(tqd_tbl2(R2, H2, tqd_idx_tq81[4])); w[5] = vreinterpretq_u32_u8(tqd_tbl2(R2, H2, tqd_idx_tq81[5]));
+        w[6] = vreinterpretq_u32_u8(tqd_tbl2(R3, H3, tqd_idx_tq81[6]));
+    } else {
+        w[0] = vreinterpretq_u32_u8(vqtbl1q_u8(R0, vld1q_u8(tqd_idx_tq9[0]))); w[1] = vreinterpretq_u32_u8(vqtbl1q_u8(R0, vld1q_u8(tqd_idx_tq9[1])));
+        w[2] = vreinterpretq_u32_u8(vqtbl1q_u8(R1, vld1q_u8(tqd_idx_tq9[2]))); w[3] = vreinterpretq_u32_u8(vqtbl1q_u8(R1, vld1q_u8(tqd_idx_tq9[3])));
+        w[4] = vreinterpretq_u32_u8(vqtbl1q_u8(R2, vld1q_u8(tqd_idx_tq9[4]))); w[5] = vreinterpretq_u32_u8(vqtbl1q_u8(R2, vld1q_u8(tqd_idx_tq9[5])));
+        w[6] = vreinterpretq_u32_u8(vqtbl1q_u8(R3, vld1q_u8(tqd_idx_tq9[6])));
+    }
+}
+
+// sum_j u_j * y_j over one TQ block (u unsigned digits); yq = the 128 Q8_K quants of this block
+static inline __attribute__((always_inline)) int32_t tqd_block_dot(const uint8_t * GGML_RESTRICT b, const int8_t * GGML_RESTRICT yq, const int N, const int W) {
+    uint32x4_t m[7];
+    tqd_words(b, m, W);
+    const uint32x4_t z = vdupq_n_u32(0);
+    int32x4_t acc0 = vdupq_n_s32(0), acc1 = vdupq_n_s32(0);
+    if (W < 32) {
+        // byte B of each 32-bit lane via two unzip levels (single-uop ops, cheaper than vqtbl4):
+        // uzp2 on u16 keeps bits 16..31; then uzp2 (B = 3, TQ27) / uzp1 (B = 2, TQ9) on bytes
+        const uint8x16_t vN = vdupq_n_u8((uint8_t) N);
+        uint8x16_t hp0 = vdupq_n_u8(0), hp1 = vdupq_n_u8(0);
+        for (int i = 0; i < 5; i++) {
+            for (int k = 0; k < 7; k++) m[k] = vmulq_n_u32(m[k], (uint32_t) N);
+            const uint16x8_t a0 = vuzp2q_u16(vreinterpretq_u16_u32(m[0]), vreinterpretq_u16_u32(m[1]));
+            const uint16x8_t a1 = vuzp2q_u16(vreinterpretq_u16_u32(m[2]), vreinterpretq_u16_u32(m[3]));
+            const uint16x8_t a2 = vuzp2q_u16(vreinterpretq_u16_u32(m[4]), vreinterpretq_u16_u32(m[5]));
+            const uint16x8_t a3 = vuzp2q_u16(vreinterpretq_u16_u32(m[6]), vreinterpretq_u16_u32(z));
+            const uint8x16_t h0 = W == 24 ? vuzp2q_u8(vreinterpretq_u8_u16(a0), vreinterpretq_u8_u16(a1))
+                                          : vuzp1q_u8(vreinterpretq_u8_u16(a0), vreinterpretq_u8_u16(a1));
+            const uint8x16_t h1 = W == 24 ? vuzp2q_u8(vreinterpretq_u8_u16(a2), vreinterpretq_u8_u16(a3))
+                                          : vuzp1q_u8(vreinterpretq_u8_u16(a2), vreinterpretq_u8_u16(a3));
+            const uint8x16_t u0 = vmlsq_u8(h0, hp0, vN);
+            const uint8x16_t u1 = vmlsq_u8(h1, hp1, vN);
+            hp0 = h0; hp1 = h1;
+            acc0 = ggml_vdotq_s32(acc0, vreinterpretq_s8_u8(u0), vld1q_s8(yq + i*TQD_NW));
+            acc1 = ggml_vdotq_s32(acc1, vreinterpretq_s8_u8(u1), vld1q_s8(yq + i*TQD_NW + 16));
+        }
+    } else {
+        const uint32x2_t vN2 = vdup_n_u32((uint32_t) N);
+        const uint32x4_t vN4 = vdupq_n_u32((uint32_t) N);
+        for (int i = 0; i < 5; i++) {
+            uint32x4_t u[8];
+            for (int k = 0; k < 7; k++) {
+                const uint32x4_t lo = vreinterpretq_u32_u64(vmull_u32(vget_low_u32(m[k]), vN2));
+                const uint32x4_t hi = vreinterpretq_u32_u64(vmull_high_u32(m[k], vN4));
+                m[k] = vuzp1q_u32(lo, hi);
+                u[k] = vuzp2q_u32(lo, hi);
+            }
+            u[7] = z;
+            const uint16x8_t a0 = vuzp1q_u16(vreinterpretq_u16_u32(u[0]), vreinterpretq_u16_u32(u[1]));
+            const uint16x8_t a1 = vuzp1q_u16(vreinterpretq_u16_u32(u[2]), vreinterpretq_u16_u32(u[3]));
+            const uint16x8_t a2 = vuzp1q_u16(vreinterpretq_u16_u32(u[4]), vreinterpretq_u16_u32(u[5]));
+            const uint16x8_t a3 = vuzp1q_u16(vreinterpretq_u16_u32(u[6]), vreinterpretq_u16_u32(u[7]));
+            const uint8x16_t u0 = vuzp1q_u8(vreinterpretq_u8_u16(a0), vreinterpretq_u8_u16(a1));
+            const uint8x16_t u1 = vuzp1q_u8(vreinterpretq_u8_u16(a2), vreinterpretq_u8_u16(a3));
+            acc0 = ggml_vdotq_s32(acc0, vreinterpretq_s8_u8(u0), vld1q_s8(yq + i*TQD_NW));
+            acc1 = ggml_vdotq_s32(acc1, vreinterpretq_s8_u8(u1), vld1q_s8(yq + i*TQD_NW + 16));
