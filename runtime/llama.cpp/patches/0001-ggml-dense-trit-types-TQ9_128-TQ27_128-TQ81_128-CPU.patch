+void quantize_row_##name(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, int64_t k) {                       \
+    quantize_row_##name##_ref(x, (block_##name *) y, k);                                                           \
+}                                                                                                                  \
+void ggml_vec_dot_##name##_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, \
+        const void * GGML_RESTRICT vy, size_t by, int nrc) {                                                       \
+    assert(n % QK_K == 0);                                                                                         \
+    assert(nrc == 1);                                                                                              \
