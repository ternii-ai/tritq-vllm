+void quantize_row_##name##_ref(const float * GGML_RESTRICT x, block_##name * GGML_RESTRICT y, int64_t k) {     \
+    assert(k % QK_TQD == 0);                                                                                   \
+    const int64_t nb = k / QK_TQD;                                                                             \
+    for (int64_t i = 0; i < nb; i++) {                                                                         \
