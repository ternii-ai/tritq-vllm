+    const block_q8_K   * GGML_RESTRICT y = (const block_q8_K *) vy;                                                \
+    const int L  = (NLEV - 1)/2;                                                                                   \
+    const int nb = n / QK_K;                                                                                       \
+    float sumf = 0.0f;                                                                                             \
+    for (int ib = 0; ib < nb; ib++) {                                                                              \
+        float part = 0.0f;                                                                                         \
+        for (int h = 0; h < 2; h++) {                                                                              \
+            const block_##name * xb = &x[2*ib + h];                                                                \
+            const int32_t isum = tqd_block_dot((const uint8_t *) xb, y[ib].qs + QK_TQD*h, NLEV, WB);               \
+            int32_t bsum = 0;                                                                                      \
