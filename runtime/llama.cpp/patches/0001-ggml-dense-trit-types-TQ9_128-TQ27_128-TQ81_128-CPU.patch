+        tqd_quantize_block(x + i*QK_TQD, &b->d, b->lo, HI8, HI16, NLEV, WB);                                   \
+    }                                                                                                          \
+}                                                                                                              \
+void dequantize_row_##name(const block_##name * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {        \
+    assert(k % QK_TQD == 0);                                                                                   \
+    const int64_t nb = k / QK_TQD;                                                                             \
+    for (int64_t i = 0; i < nb; i++) {                                                                         \
+        const block_##name * b = &x[i];                                                                        \
