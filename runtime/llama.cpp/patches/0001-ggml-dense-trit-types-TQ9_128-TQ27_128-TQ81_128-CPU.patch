+// ===== Dense trit (TQ*_128): exact k-trit integer codes, one fp16 key per 128 weights =====
+// Each weight = d * q, q integer in [-(N-1)/2, (N-1)/2]. The 128 codes become digits u = q + (N-1)/2
+// in [0, N) and are packed 5 per W-bit word (N^5 < 2^W) in MIXED RADIX, stored as a fixed-point
+// fraction x = ceil(v * 2^W / N^5), v = u0*N^4 + u1*N^3 + ... + u4 (TQ1_0's trick generalised).
+// Decode is multiply-only, no division:  t = x; for i in 0..4: { t *= N; u_i = t >> W; t &= 2^W-1 }
+// (for W = 32: u_i = mulhi(t, N); t = t*N mod 2^32). Exact for every v < N^5 (proved + exhaustively
+// checked for N = 9/27/81). 26 words carry 130 digit slots; weight j lives in word j % 26, digit
+// j / 26, so decoding digit i across all 26 words yields 26 CONTIGUOUS weights (SIMD friendly).
+// Slots 128,129 (digit 4 of words 24,25) are padding (encoded as u = 0, ignored by decoders).
+// Word w = lo[w] | hi[w] << 16 (no hi for W = 16). Every field is 2-byte aligned.
+// Any odd N <= 9 / 27 / 81 is carried exactly by TQ9 / TQ27 / TQ81 (e.g. N = 15, 21 -> TQ27; 45, 63 -> TQ81).
+#define QK_TQD   128
+#define TQD_NW   26      // words per block
+#define TQ9_N    9
+#define TQ9_W    16
+#define TQ27_N   27
+#define TQ27_W   24
+#define TQ81_N   81
+#define TQ81_W   32
+typedef struct {
+    ggml_half d;
+    uint16_t  lo[TQD_NW];
+} block_tq9_128;
+static_assert(sizeof(block_tq9_128) == sizeof(ggml_half) + 2*TQD_NW, "wrong tq9_128 block size/padding");
+typedef struct {
+    ggml_half d;
+    uint16_t  lo[TQD_NW];
+    uint8_t   hi[TQD_NW];
+} block_tq27_128;
+static_assert(sizeof(block_tq27_128) == sizeof(ggml_half) + 3*TQD_NW, "wrong tq27_128 block size/padding");
+typedef struct {
+    ggml_half d;
+    uint16_t  lo[TQD_NW];
+    uint16_t  hi[TQD_NW];
+} block_tq81_128;
+static_assert(sizeof(block_tq81_128) == sizeof(ggml_half) + 4*TQD_NW, "wrong tq81_128 block size/padding");
+
 #define QK4_0 32
 typedef struct {
     ggml_half d;           // delta
