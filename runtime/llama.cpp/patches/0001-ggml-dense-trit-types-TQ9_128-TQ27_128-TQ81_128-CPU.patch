+static inline uint64_t tqd_pow5(int N) { return (uint64_t)N*N*N*N*N; }
+
+static void tqd_quantize_block(const float * GGML_RESTRICT x, ggml_half * d_out, uint16_t * lo, uint8_t * hi8, uint16_t * hi16, int N, int W) {
+    const int L = (N - 1)/2;
+    float amax = 0.0f;
+    for (int j = 0; j < QK_TQD; j++) { const float a = fabsf(x[j]); if (a > amax) amax = a; }
+    const ggml_half dh = GGML_FP32_TO_FP16(amax / L);
+    float d = GGML_FP16_TO_FP32(dh);
+    if (d == 0.0f) d = 1.0f;
+    *d_out = dh;
+    uint8_t u[5*TQD_NW] = {0};
+    for (int j = 0; j < QK_TQD; j++) {
+        int q = (int) nearbyintf(x[j] / d);
+        q = q < -L ? -L : (q > L ? L : q);
+        u[j] = (uint8_t)(q + L);
+    }
+    const uint64_t N5 = tqd_pow5(N);
+    for (int w = 0; w < TQD_NW; w++) {
+        uint64_t v = 0;
+        for (int i = 0; i < 5; i++) v = v*N + u[i*TQD_NW + w];
+        const uint64_t xw = ((v << W) + N5 - 1) / N5;   // < 2^W; W=32: v<<32 < 1.5e19 fits uint64
+        lo[w] = (uint16_t)(xw & 0xFFFF);
+        if (hi8)  hi8[w]  = (uint8_t) (xw >> 16);
+        if (hi16) hi16[w] = (uint16_t)(xw >> 16);
+    }
+}
+
+static void tqd_dequantize_block(float d, const uint16_t * lo, const uint8_t * hi8, const uint16_t * hi16, float * GGML_RESTRICT y, int N, int W) {
+    const int L = (N - 1)/2;
+    const uint64_t mask = (1ull << W) - 1;
+    for (int w = 0; w < TQD_NW; w++) {
+        uint64_t t = lo[w] | (hi8 ? ((uint64_t)hi8[w] << 16) : 0) | (hi16 ? ((uint64_t)hi16[w] << 16) : 0);
+        for (int i = 0; i < 5; i++) {
+            t *= (uint64_t)N;
+            const int u = (int)(t >> W);
+            t &= mask;
+            const int j = i*TQD_NW + w;
+            if (j < QK_TQD) y[j] = (float)(u - L) * d;
+        }
+    }
+}
