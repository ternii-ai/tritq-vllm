From a2f859bc5e07d0a8c3bf31222dc2a6c5755e0385 Mon Sep 17 00:00:00 2001
From: Wai Chung <351198037+ternii-ai@users.noreply.github.com>
Date: Wed, 25 Nov 2026 12:00:04 +0000
Subject: [PATCH 22/22] ggml-metal: pre-encode the next graph while the GPU
 runs

Right after a graph is committed, the same graph is encoded again into
one command buffer for the next compute, while the GPU is still busy
with the current one. The next compute commits that buffer straight
away if it gets the same graph and no graph_optimize (re-split) has run
since; otherwise the buffer is dropped and the graph is encoded as
before. "Same graph" is checked against a snapshot taken
while encoding: n_cb, the fusion and concurrency switches, every node's
ggml_tensor struct, and every source's data and buffer pointers. Callers
of ggml_backend_graph_compute that bypass the scheduler (such as
test-backend-ops) rebuild graphs at the same address with the same node
count and never trigger graph_optimize. The check is a streaming
compare of about 1.4 MB for a 35B decode graph. This takes the CPU encode
of a decode token (about 1,500 nodes) off the critical path and leaves
no GPU idle between command buffers.

The node ranges are exactly those of the regular path (the main
thread's first nodes, then the n_cb parts), each with its own encoder,
in the order the regular command buffers run. Fusions are found within
a range, so the same ranges give the same kernels: output is
bit-identical. (Encoding the whole graph as one range would change
which fusions are made at the range boundary, and with them the
values.)

Not used with the profiler, a capture, an abort callback, fusion stats
or the in-buffer MoE expert cache (LLAMA_MOE_ASYNC). Encoding happens on
the calling thread, never in the background: llama may rebuild the next
graph without a synchronize in between. GGML_METAL_PREENCODE=0 turns it
off.
---
 ggml/src/ggml-metal/ggml-metal-context.m | 229 +++++++++++++++++++++++
 1 file changed, 229 insertions(+)

diff --git a/ggml/src/ggml-metal/ggml-metal-context.m b/ggml/src/ggml-metal/ggml-metal-context.m
index dec173e3e..13560ee01 100644
--- a/ggml/src/ggml-metal/ggml-metal-context.m
+++ b/ggml/src/ggml-metal/ggml-metal-context.m
@@ -82,6 +82,21 @@
     // error state - set when a command buffer fails during synchronize
     // once set, graph_compute will return GGML_STATUS_FAILED until the backend is recreated
     bool has_error;
+
+    // pre-encode (GGML_METAL_PREENCODE): right after a graph is committed, the same graph is encoded again into one
+    // command buffer for the next compute, while the GPU runs the current one. The next compute commits that buffer if it
+    // gets the same graph (same object, node array and node count) and no graph_optimize (re-split) has run since.
+    id<MTLCommandBuffer>   pre_cb;
+    struct ggml_cgraph *   pre_gf;
+    struct ggml_tensor **  pre_nodes;
+    int                    pre_n_nodes;
+    uint8_t *              pre_snap;    // snapshot of the pre-encoded graph: every node struct + its sources' data/buffer pointers
+    size_t                 pre_snap_n;  // bytes used
+    size_t                 pre_snap_cap;
+    uint64_t               pre_gen;
+    uint64_t               graph_gen;
+    int64_t                pre_hits;
+    int64_t                pre_miss;
 };
 
 // (tq expert cache) MoE expert cache, asynchronous in-buffer mode: every graph_compute is ONE command buffer that starts with a
@@ -368,6 +383,18 @@ ggml_metal_t ggml_metal_init(ggml_metal_device_t dev) {
 
         res->cmd_buf_last = nil;
 
+        res->pre_cb      = nil;
+        res->pre_gf      = NULL;
+        res->pre_nodes   = NULL;
+        res->pre_n_nodes = 0;
+        res->pre_snap     = NULL;
+        res->pre_snap_n   = 0;
+        res->pre_snap_cap = 0;
+        res->pre_gen     = 0;
+        res->graph_gen   = 0;
+        res->pre_hits    = 0;
+        res->pre_miss    = 0;
+
         res->pipelines_ext = ggml_metal_pipelines_init();
 
         return res;
@@ -378,6 +405,15 @@ void ggml_metal_free(ggml_metal_t ctx) {
     if (prof_mode() > 0) { os_unfair_lock_lock(&g_prof_lock); prof_report(); os_unfair_lock_unlock(&g_prof_lock); }
     GGML_LOG_INFO("%s: deallocating\n", __func__);
 
+    if (ctx->pre_cb) {
+        [ctx->pre_cb release];
+        ctx->pre_cb = nil;
+    }
+    free(ctx->pre_snap);
+    if (ctx->pre_hits || ctx->pre_miss) {
+        GGML_LOG_INFO("%s: pre-encoded graphs used %lld, discarded %lld\n", __func__, (long long) ctx->pre_hits, (long long) ctx->pre_miss);
+    }
+
     for (int i = 0; i < GGML_METAL_MAX_COMMAND_BUFFERS; ++i) {
         if (ctx->cmd_bufs[i].obj) {
             [ctx->cmd_bufs[i].obj release];
@@ -654,6 +690,158 @@ bool ggml_metal_cpy_tensor_async(ggml_metal_t ctx_src, ggml_metal_t ctx_dst, con
     }
 }
 
+#ifndef GGML_METAL_PREENCODE_DEFAULT
+#define GGML_METAL_PREENCODE_DEFAULT 1
+#endif
+static bool ggml_metal_preenc_env(void) {
+    static int v = -1;
+    if (v < 0) { const char * e = getenv("GGML_METAL_PREENCODE"); v = e ? (atoi(e) != 0) : GGML_METAL_PREENCODE_DEFAULT; }
+    return v;
+}
+
+// not with the profiler, a capture, an abort callback (checked between command buffers) or the in-buffer expert cache
+// (each of its command buffers waits for and signals per-graph events)
+static bool ggml_metal_preenc_on(ggml_metal_t ctx) {
+    return ggml_metal_preenc_env() && prof_mode() == 0 && ctx->capture_compute < 0 && ctx->abort_callback == NULL &&
+           !g_moe_inbuf && !ggml_metal_fusion_info_stats(ctx->finfo);
+}
+
+// "same graph" check for the pre-encoded command buffer. A graph can be rebuilt at the same address with the same node
+// count without a graph_optimize (callers of ggml_backend_graph_compute that bypass the scheduler, e.g. test-backend-ops),
+// so the whole graph is compared: n_cb and the fusion / concurrency switches, every node's ggml_tensor struct (op, type,
+// flags, shape, strides, op_params, data, buffer, sources, views) and, for every source, its data and buffer pointers.
+// The snapshot is taken while encoding (off the critical path); the check is a streaming compare (a few tens of us).
+struct ggml_metal_snap_hdr { int32_t n_nodes; int32_t n_cb; int32_t fusion; int32_t conc; };
+struct ggml_metal_snap_src { void * data; void * buffer; };
+
+static size_t ggml_metal_snap_size(const struct ggml_cgraph * gf) {
+    return sizeof(struct ggml_metal_snap_hdr) + (size_t) gf->n_nodes * (sizeof(struct ggml_tensor) + GGML_MAX_SRC*sizeof(struct ggml_metal_snap_src));
+}
+
+static void ggml_metal_snap_node_srcs(const struct ggml_tensor * t, struct ggml_metal_snap_src * out) {
+    for (int j = 0; j < GGML_MAX_SRC; ++j) {
+        const struct ggml_tensor * sj = t->src[j];
+        out[j].data   = sj ? sj->data   : NULL;
+        out[j].buffer = sj ? (void *) sj->buffer : NULL;
+    }
+}
+
+static void ggml_metal_snap_hdr_fill(ggml_metal_t ctx, const struct ggml_cgraph * gf, struct ggml_metal_snap_hdr * h) {
+    memset(h, 0, sizeof(*h));
+    h->n_nodes = gf->n_nodes;
+    h->n_cb    = ctx->n_cb;
+    h->fusion  = ggml_metal_fusion_info_enabled(ctx->finfo);
+    h->conc    = ctx->use_concurrency;
+}
+
+static void ggml_metal_snap_take(ggml_metal_t ctx, const struct ggml_cgraph * gf) {
+    const size_t need = ggml_metal_snap_size(gf);
+    if (ctx->pre_snap_cap < need) {
+        free(ctx->pre_snap);
+        ctx->pre_snap     = (uint8_t *) malloc(need);
+        ctx->pre_snap_cap = ctx->pre_snap ? need : 0;
+    }
+    ctx->pre_snap_n = 0;
+    if (!ctx->pre_snap) {
+        return;
+    }
+    uint8_t * p = ctx->pre_snap;
+    ggml_metal_snap_hdr_fill(ctx, gf, (struct ggml_metal_snap_hdr *) p); p += sizeof(struct ggml_metal_snap_hdr);
+    for (int i = 0; i < gf->n_nodes; ++i) {
+        memcpy(p, gf->nodes[i], sizeof(struct ggml_tensor)); p += sizeof(struct ggml_tensor);
+        ggml_metal_snap_node_srcs(gf->nodes[i], (struct ggml_metal_snap_src *) p); p += GGML_MAX_SRC*sizeof(struct ggml_metal_snap_src);
+    }
+    ctx->pre_snap_n = need;
+}
+
+static bool ggml_metal_snap_same(ggml_metal_t ctx, const struct ggml_cgraph * gf) {
+    if (!ctx->pre_snap || ctx->pre_snap_n != ggml_metal_snap_size(gf)) {
+        return false;
+    }
+    const uint8_t * p = ctx->pre_snap;
+    struct ggml_metal_snap_hdr h;
+    ggml_metal_snap_hdr_fill(ctx, gf, &h);
+    if (memcmp(p, &h, sizeof(h)) != 0) {
+        return false;
+    }
+    p += sizeof(h);
+    struct ggml_metal_snap_src srcs[GGML_MAX_SRC];
+    for (int i = 0; i < gf->n_nodes; ++i) {
+        if (memcmp(p, gf->nodes[i], sizeof(struct ggml_tensor)) != 0) {
+            return false;
+        }
+        p += sizeof(struct ggml_tensor);
+        ggml_metal_snap_node_srcs(gf->nodes[i], srcs);
+        if (memcmp(p, srcs, sizeof(srcs)) != 0) {
+            return false;
+        }
+        p += sizeof(srcs);
+    }
+    return true;
+}
+
+static void ggml_metal_preenc_drop(ggml_metal_t ctx) {
+    if (ctx->pre_cb) {
+        [ctx->pre_cb release];
+        ctx->pre_cb = nil;
+        ctx->pre_miss++;
+    }
+}
+
+// encodes on the calling thread right after the graph was committed: the GPU is busy with it, and the graph cannot
+// change underneath (llama may rebuild the next graph without a synchronize in between, so no background thread).
+// The node ranges are exactly those of the regular path (the main thread's first nodes, then the n_cb parts), each with its
+// own encoder, in the order the regular command buffers run: fusions are found within a range, so the same ranges give the
+// same kernels and bit-identical output. Only the command buffer count (one) and the encode time (off the critical path) change.
+static void ggml_metal_preenc_schedule(ggml_metal_t ctx, struct ggml_cgraph * gf) {
+    id<MTLCommandQueue> queue = ggml_metal_device_get_queue(ctx->dev);
+    id<MTLCommandBuffer> cb = [queue commandBufferWithUnretainedReferences];
+    [cb retain];
+    ctx->pre_cb      = cb;
+    ctx->pre_gf      = gf;
+    ctx->pre_nodes   = gf->nodes;
+    ctx->pre_n_nodes = gf->n_nodes;
+    ggml_metal_snap_take(ctx, gf);
+    ctx->pre_gen     = ctx->graph_gen;
+
+    // same split as ggml_metal_graph_compute
+    const int n_main = MAX(64, 0.1*gf->n_nodes);
+    const int n_cb   = ctx->n_cb;
+    int r0[GGML_METAL_MAX_COMMAND_BUFFERS + 1];
+    int r1[GGML_METAL_MAX_COMMAND_BUFFERS + 1];
+    int n_r = 0;
+    if (n_cb == 0) {
+        r0[n_r] = 0; r1[n_r] = gf->n_nodes; n_r++;
+    } else {
+        const int n_nodes_0      = MIN(n_main, gf->n_nodes);
+        const int n_nodes_1      = gf->n_nodes - n_nodes_0;
+        const int n_nodes_per_cb = (n_nodes_1 + n_cb - 1) / n_cb;
+        r0[n_r] = 0; r1[n_r] = n_nodes_0; n_r++;
+        for (int cb_idx = 0; cb_idx < n_cb; ++cb_idx) {
+            r0[n_r] = n_nodes_0 + (cb_idx + 0) * n_nodes_per_cb;
+            r1[n_r] = n_nodes_0 + MIN((cb_idx == n_cb - 1) ? n_nodes_1 : (cb_idx + 1) * n_nodes_per_cb, n_nodes_1);
+            n_r++;
+        }
+    }
+
+    @autoreleasepool {
+        for (int r = 0; r < n_r; ++r) {
+            if (r0[r] >= r1[r]) {
+                continue;
+            }
+            ggml_metal_op_t ctx_op = ggml_metal_op_init(ctx->dev, cb, gf, ctx->finfo, r0[r], r1[r], ctx->use_concurrency, false, ctx->debug_graph);
+            for (int idx = 0; idx < ggml_metal_op_n_nodes(ctx_op); ++idx) {
+                const int res = ggml_metal_op_encode(ctx_op, idx);
+                if (res == 0) {
+                    break;
+                }
+                idx += res - 1;
+            }
+            ggml_metal_op_free(ctx_op);
+        }
+    }
+}
+
 enum ggml_status ggml_metal_graph_compute(ggml_metal_t ctx, struct ggml_cgraph * gf) {
     if (ctx->has_error) {
         GGML_LOG_ERROR("%s: backend is in error state from a previous command buffer failure - recreate the backend to recover\n", __func__);
@@ -664,6 +852,39 @@ enum ggml_status ggml_metal_graph_compute(ggml_metal_t ctx, struct ggml_cgraph *
         return GGML_STATUS_SUCCESS;
     }
 
+    const bool preenc = ggml_metal_preenc_on(ctx);
+    if (ctx->pre_cb) {
+        if (preenc && ctx->pre_gf == gf && ctx->pre_nodes == gf->nodes && ctx->pre_n_nodes == gf->n_nodes && ctx->pre_gen == ctx->graph_gen &&
+            ggml_metal_snap_same(ctx, gf)) {
+            id<MTLCommandBuffer> cb = ctx->pre_cb;
+            ctx->pre_cb = nil;
+            if (ctx->pre_hits++ == 0) {
+                GGML_LOG_INFO("%s: using a pre-encoded command buffer (GGML_METAL_PREENCODE)\n", __func__);
+            }
+
+            ggml_metal_device_rsets_keep_alive(ctx->dev);
+
+            for (int i = 0; i <= ctx->n_cb; ++i) {
+                if (ctx->cmd_bufs[i].obj) {
+                    [ctx->cmd_bufs[i].obj release];
+                    ctx->cmd_bufs[i].obj = nil;
+                }
+            }
+            ctx->cmd_bufs[ctx->n_cb].obj = cb; // owned, released like the regular command buffers
+            ctx->gf = gf;
+
+            [cb commit];
+            ctx->cmd_buf_last = cb;
+
+            @autoreleasepool {
+                ggml_metal_preenc_schedule(ctx, gf);
+            }
+
+            return GGML_STATUS_SUCCESS;
+        }
+        ggml_metal_preenc_drop(ctx);
+    }
+
     // number of nodes encoded by the main thread (empirically determined)
     const int n_main = MAX(64, 0.1*gf->n_nodes);
 
@@ -777,6 +998,10 @@ enum ggml_status ggml_metal_graph_compute(ggml_metal_t ctx, struct ggml_cgraph *
 
         dispatch_apply(n_cb, ctx->d_queue, ctx->encode_async);
 
+        if (preenc && !use_capture) {
+            ggml_metal_preenc_schedule(ctx, gf);
+        }
+
         // for debugging: block until graph is computed
         //[ctx->cmd_buf_last waitUntilCompleted];
 
@@ -845,6 +1070,10 @@ enum ggml_status ggml_metal_graph_compute(ggml_metal_t ctx, struct ggml_cgraph *
 void ggml_metal_graph_optimize(ggml_metal_t ctx, struct ggml_cgraph * gf) {
     //const int64_t t_start = ggml_time_us();
 
+    // a (re)split graph invalidates any pre-encoded command buffer
+    ggml_metal_preenc_drop(ctx);
+    ctx->graph_gen++;
+
     if (ctx->use_graph_optimize) {
         ggml_graph_optimize(gf);
     }
-- 
