From dea157381d78e95642f2c8f6bf310246d62d9aa1 Mon Sep 17 00:00:00 2001
From: Wai Chung <351198037+ternii-ai@users.noreply.github.com>
Date: Fri, 20 Nov 2026 08:26:21 +0000
Subject: [PATCH] ggml-cpu: AVX2 dot product for the dense trit types (x86)

On x86 the TQ9/TQ27/TQ81 x Q8_0 dot product was the scalar reference. The
AVX2 version decodes the 26 words of a block in 32-bit lanes (vpmulld, or
vpmuludq for TQ81), packs the 128 digits to signed codes in weight order
and does one vpmaddubsw dot per Q8_0 sub-block. Integer sums and the float
accumulation order are those of the scalar code, so results are bitwise
identical to it (built with the same compiler flags).

tools/tq_exact/tq_vecdot_check.c checks this: it compares the build's
vec_dot with a scalar reference on random and quantised rows.
---
 ggml/src/ggml-cpu/quants.c       |  92 +++++++++++++++++++++++++++
 tools/tq_exact/tq_vecdot_check.c | 103 +++++++++++++++++++++++++++++++
 2 files changed, 195 insertions(+)
 create mode 100644 tools/tq_exact/tq_vecdot_check.c

diff --git a/ggml/src/ggml-cpu/quants.c b/ggml/src/ggml-cpu/quants.c
index 0e8d28a08..a93212b9b 100644
--- a/ggml/src/ggml-cpu/quants.c
+++ b/ggml/src/ggml-cpu/quants.c
@@ -413,6 +413,96 @@ static inline void tqd_block_digits(const uint8_t * GGML_RESTRICT b, uint8_t * G
     }
 }
 
+#if defined(__AVX2__)
+// x86 AVX2 for the Q8_0 pairing. The 26 words of a block go to 32-bit lanes 0..25 of four __m256i (lanes 26..31 = 0).
+// Per digit row i: t *= N; u = t >> W; t &= 2^W - 1 (W < 32), or vpmuludq on even / odd lanes with u = the high half
+// (W = 32). The 32 u's are packed to bytes in lane order (lane w = weight 26i + w) and stored as signed codes u - L at
+// q[26i]; rows go in increasing i, so each row overwrites the previous row's 6 tail lanes, and row 4's lanes 24..31
+// (padding weights 128, 129 and the zero lanes) land in the slack q[128..159]. Each Q8_0 sub-block is then one
+// vpmaddubsw(|q|, sign(y, q)) dot (|pair| <= 2*40*127). The integer sums equal isum - L*bsum of the scalar code and
+// the float accumulation order is the same, so the result is bitwise identical to the scalar path.
+static inline __attribute__((always_inline)) __m256i tqd_x86_u16x8(const uint8_t * p) {
+    return _mm256_cvtepu16_epi32(_mm_loadu_si128((const __m128i *) p));
+}
+
+static inline __attribute__((always_inline)) void tqd_x86_codes(const uint8_t * GGML_RESTRICT b, int8_t * GGML_RESTRICT q, const int N, const int W) {
+    __m256i m[4];
+    // lo: words 0..7, 8..15, 16..23 at b+2/18/34; words 24, 25 = the top 4 bytes of the 16 at b+38 (no read past the block)
+    m[0] = tqd_x86_u16x8(b + 2);
+    m[1] = tqd_x86_u16x8(b + 18);
+    m[2] = tqd_x86_u16x8(b + 34);
+    m[3] = _mm256_cvtepu16_epi32(_mm_srli_si128(_mm_loadu_si128((const __m128i *) (b + 38)), 12));
+    if (W == 24) {          // hi: 26 bytes at b+54
+        uint16_t h2; memcpy(&h2, b + 78, 2);
+        m[0] = _mm256_or_si256(m[0], _mm256_slli_epi32(_mm256_cvtepu8_epi32(_mm_loadl_epi64((const __m128i *) (b + 54))), 16));
+        m[1] = _mm256_or_si256(m[1], _mm256_slli_epi32(_mm256_cvtepu8_epi32(_mm_loadl_epi64((const __m128i *) (b + 62))), 16));
+        m[2] = _mm256_or_si256(m[2], _mm256_slli_epi32(_mm256_cvtepu8_epi32(_mm_loadl_epi64((const __m128i *) (b + 70))), 16));
+        m[3] = _mm256_or_si256(m[3], _mm256_slli_epi32(_mm256_cvtepu8_epi32(_mm_cvtsi32_si128(h2)), 16));
+    } else if (W == 32) {   // hi: 26 uint16 at b+54
+        m[0] = _mm256_or_si256(m[0], _mm256_slli_epi32(tqd_x86_u16x8(b + 54), 16));
+        m[1] = _mm256_or_si256(m[1], _mm256_slli_epi32(tqd_x86_u16x8(b + 70), 16));
+        m[2] = _mm256_or_si256(m[2], _mm256_slli_epi32(tqd_x86_u16x8(b + 86), 16));
+        m[3] = _mm256_or_si256(m[3], _mm256_slli_epi32(
+            _mm256_cvtepu16_epi32(_mm_srli_si128(_mm_loadu_si128((const __m128i *) (b + 90)), 12)), 16));
+    }
+    const __m256i vN   = _mm256_set1_epi32(N);
+    const __m256i mask = _mm256_set1_epi32(W >= 32 ? -1 : (int) ((1u << W) - 1));
+    const __m256i perm = _mm256_setr_epi32(0, 4, 1, 5, 2, 6, 3, 7);
+    const __m256i vL   = _mm256_set1_epi8((char) ((N - 1)/2));
+    for (int i = 0; i < 5; i++) {
+        __m256i u[4];
+        if (W < 32) {
+            for (int k = 0; k < 4; k++) {
+                const __m256i t = _mm256_mullo_epi32(m[k], vN);
+                u[k] = _mm256_srli_epi32(t, W);
+                m[k] = _mm256_and_si256(t, mask);
+            }
+        } else {
+            for (int k = 0; k < 4; k++) {
+                const __m256i pe = _mm256_mul_epu32(m[k], vN);                          // lanes 0, 2, 4, 6
+                const __m256i po = _mm256_mul_epu32(_mm256_srli_epi64(m[k], 32), vN);   // lanes 1, 3, 5, 7
+                u[k] = _mm256_blend_epi32(_mm256_srli_epi64(pe, 32), po, 0xAA);
+                m[k] = _mm256_blend_epi32(pe, _mm256_slli_epi64(po, 32), 0xAA);
+            }
+        }
+        const __m256i u8 = _mm256_permutevar8x32_epi32(
+            _mm256_packus_epi16(_mm256_packus_epi32(u[0], u[1]), _mm256_packus_epi32(u[2], u[3])), perm);
+        _mm256_storeu_si256((__m256i *) (q + i*TQD_NW), _mm256_sub_epi8(u8, vL));
+    }
+}
+
+static inline __attribute__((always_inline)) int32_t tqd_x86_dot32(const int8_t * GGML_RESTRICT q, const int8_t * GGML_RESTRICT y) {
+    const __m256i qv = _mm256_loadu_si256((const __m256i *) q);
+    const __m256i yv = _mm256_loadu_si256((const __m256i *) y);
+    const __m256i p  = _mm256_madd_epi16(_mm256_maddubs_epi16(_mm256_sign_epi8(qv, qv), _mm256_sign_epi8(yv, qv)), _mm256_set1_epi16(1));
+    const __m128i s4 = _mm_add_epi32(_mm256_castsi256_si128(p), _mm256_extracti128_si256(p, 1));
+    const __m128i s2 = _mm_add_epi32(s4, _mm_shuffle_epi32(s4, _MM_SHUFFLE(1, 0, 3, 2)));
+    return _mm_cvtsi128_si32(_mm_add_epi32(s2, _mm_shuffle_epi32(s2, _MM_SHUFFLE(2, 3, 0, 1))));
+}
+
+#define TQD_VEC_DOT_Q8_0(name, NLEV, WB)                                                                           \
+void ggml_vec_dot_##name##_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, \
+        const void * GGML_RESTRICT vy, size_t by, int nrc) {                                                       \
+    assert(n % QK_TQD == 0);                                                                                       \
+    assert(nrc == 1);                                                                                              \
+    UNUSED(nrc); UNUSED(bx); UNUSED(by); UNUSED(bs);                                                               \
+    const block_##name * GGML_RESTRICT x = (const block_##name *) vx;                                              \
+    const block_q8_0   * GGML_RESTRICT y = (const block_q8_0 *) vy;                                                \
+    const int nb = n / QK_TQD;                                                                                     \
+    int8_t q[QK_TQD + 32];                                                                                         \
+    float sumf = 0.0f;                                                                                             \
+    for (int ib = 0; ib < nb; ib++) {                                                                              \
+        tqd_x86_codes((const uint8_t *) &x[ib], q, NLEV, WB);                                                      \
+        float part = 0.0f;                                                                                         \
+        for (int k = 0; k < QK_TQD/QK8_0; k++) {                                                                   \
+            const block_q8_0 * yb = &y[ib*(QK_TQD/QK8_0) + k];                                                     \
+            part += GGML_CPU_FP16_TO_FP32(yb->d) * (float) tqd_x86_dot32(q + k*QK8_0, yb->qs);                     \
+        }                                                                                                          \
+        sumf += GGML_CPU_FP16_TO_FP32(x[ib].d) * part;                                                             \
+    }                                                                                                              \
+    *s = sumf;                                                                                                     \
+}
+#else
 #define TQD_VEC_DOT_Q8_0(name, NLEV, WB)                                                                           \
 void ggml_vec_dot_##name##_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, \
         const void * GGML_RESTRICT vy, size_t by, int nrc) {                                                       \
@@ -439,6 +529,8 @@ void ggml_vec_dot_##name##_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const
     *s = sumf;                                                                                                     \
 }
 
+#endif
+
 TQD_VEC_DOT_Q8_0(tq9_128,  TQ9_N,  TQ9_W)
 TQD_VEC_DOT_Q8_0(tq27_128, TQ27_N, TQ27_W)
 TQD_VEC_DOT_Q8_0(tq81_128, TQ81_N, TQ81_W)
diff --git a/tools/tq_exact/tq_vecdot_check.c b/tools/tq_exact/tq_vecdot_check.c
new file mode 100644
index 000000000..177650e72
--- /dev/null
+++ b/tools/tq_exact/tq_vecdot_check.c
@@ -0,0 +1,103 @@
+// Exactness check: ggml's CPU vec_dot for TQ9/27/81_128 x Q8_0 (whatever SIMD path this build uses) against a scalar
+// reference written here, on (a) random valid words incl. nonzero padding digits, (b) ggml_quantize_chunk of random
+// floats. Float accumulation order matches the TQD_VEC_DOT macro, so results must be bitwise equal.
+// usage: tq_vecdot_check [rows per case]
+#include "ggml.h"
+#include "ggml-cpu.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct { uint16_t d; int8_t qs[32]; } bq80;
+
+static uint64_t rs = 0x9E3779B97F4A7C15ull;
+static uint64_t rnd(void) { rs ^= rs << 13; rs ^= rs >> 7; rs ^= rs << 17; return rs; }
+
+static void ref_digits(const uint8_t * b, uint8_t * u, int N, int W) {
+    const uint64_t mask = W >= 32 ? 0xFFFFFFFFull : ((1ull << W) - 1);
+    for (int w = 0; w < 26; w++) {
+        uint64_t t = (uint64_t) (b[2 + 2*w] | (b[3 + 2*w] << 8));
+        if (W == 24) t |= (uint64_t) b[54 + w] << 16;
+        if (W == 32) t |= (uint64_t) (b[54 + 2*w] | (b[55 + 2*w] << 8)) << 16;
+        for (int i = 0; i < 5; i++) {
+            t *= (uint64_t) N;
+            const int j = i*26 + w;
+            if (j < 128) u[j] = (uint8_t) (t >> W);
+            t &= mask;
+        }
+    }
+}
+
+static float ref_dot(int n, const uint8_t * x, size_t bsz, const bq80 * y, int N, int W) {
+    const int L = (N - 1)/2;
+    uint8_t u[128];
+    float sumf = 0.0f;
+    for (int ib = 0; ib < n/128; ib++) {
+        const uint8_t * xb = x + ib*bsz;
+        ref_digits(xb, u, N, W);
+        float part = 0.0f;
+        for (int k = 0; k < 4; k++) {
+            const bq80 * yb = &y[ib*4 + k];
+            int32_t isum = 0, bsum = 0;
+            for (int j = 0; j < 32; j++) { isum += (int32_t) u[32*k + j] * yb->qs[j]; bsum += yb->qs[j]; }
+            part += ggml_fp16_to_fp32(yb->d) * (float) (isum - L*bsum);
+        }
+        uint16_t dh; memcpy(&dh, xb, 2);
+        sumf += ggml_fp16_to_fp32(dh) * part;
+    }
+    return sumf;
+}
+
+int main(int argc, char ** argv) {
+    const int rows = argc > 1 ? atoi(argv[1]) : 2000;
+    ggml_cpu_init();
+    const enum ggml_type types[3] = { GGML_TYPE_TQ9_128, GGML_TYPE_TQ27_128, GGML_TYPE_TQ81_128 };
+    const int Ns[3] = { 9, 27, 81 }, Ws[3] = { 16, 24, 32 };
+    const int lens[5] = { 128, 640, 2048, 4096, 9728 };
+    int fails = 0; long checked = 0;
+    for (int t = 0; t < 3; t++) {
+        const struct ggml_type_traits_cpu * tc = ggml_get_type_traits_cpu(types[t]);
+        const size_t bsz = ggml_type_size(types[t]);
+        int tf = 0; long tn = 0;
+        for (int li = 0; li < 5; li++) {
+            const int n = lens[li];
+            uint8_t * x = malloc(bsz * n/128);
+            bq80 * y = malloc(sizeof(bq80) * n/32);
+            float * f = malloc(sizeof(float) * n);
+            for (int r = 0; r < rows; r++) {
+                if (r % 2 == 0) {   // random raw words (any W-bit word decodes to digits in [0, N)), padding digits nonzero
+                    for (int b = 0; b < n/128; b++) {
+                        uint8_t * xb = x + b*bsz;
+                        const uint16_t dh = 0x2000 | (rnd() & 0x0FFF);   // small positive fp16 key
+                        memcpy(xb, &dh, 2);
+                        for (size_t k = 2; k < bsz; k++) xb[k] = (uint8_t) rnd();
+                        if (r % 8 == 0) for (size_t k = 2; k < bsz; k++) xb[k] = 0xFF;   // all-max words
+                    }
+                } else {            // the format's own quantiser
+                    for (int k = 0; k < n; k++) f[k] = ((int64_t) (rnd() % 20001) - 10000) * 1e-4f;
+                    ggml_quantize_chunk(types[t], f, x, 0, 1, n, NULL);
+                }
+                for (int b = 0; b < n/32; b++) {
+                    y[b].d = ggml_fp32_to_fp16(1e-3f * (float) (1 + rnd() % 997));
+                    for (int k = 0; k < 32; k++) y[b].qs[k] = (int8_t) ((int) (rnd() % 255) - 127);
+                    if (r % 16 == 1) for (int k = 0; k < 32; k++) y[b].qs[k] = (k & 1) ? -127 : 127;
+                    if (r % 16 == 3) for (int k = 0; k < 32; k++) y[b].qs[k] = 127;
+                }
+                float got = 0.0f;
+                tc->vec_dot(n, &got, 0, x, 0, y, 0, 1);
+                const float want = ref_dot(n, x, bsz, y, Ns[t], Ws[t]);
+                tn++;
+                if (memcmp(&got, &want, 4) != 0) {
+                    if (tf < 5) printf("  MISMATCH %s n=%d row=%d got=%.9g want=%.9g\n", ggml_type_name(types[t]), n, r, got, want);
+                    tf++;
+                }
+            }
+            free(x); free(y); free(f);
+        }
+        printf("%-9s %ld rows  %s  (%d mismatches)\n", ggml_type_name(types[t]), tn, tf ? "FAIL" : "EXACT", tf);
+        fails += tf; checked += tn;
+    }
+    printf("%s: %ld rows, %d mismatches\n", fails ? "FAIL" : "PASS", checked, fails);
+    return fails != 0;
+}
-- 
