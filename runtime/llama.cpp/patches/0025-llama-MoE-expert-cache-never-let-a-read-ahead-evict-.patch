From e4fd581363386e5369d067974565d384e4f5c1db Mon Sep 17 00:00:00 2001
From: Wai Chung <351198037+ternii-ai@users.noreply.github.com>
Date: Sat, 28 Nov 2026 11:15:27 +0000
Subject: [PATCH 25/26] llama: MoE expert cache: never let a read-ahead evict
 an expert the GPU may be reading

A read-ahead of the next layer's experts (LLAMA_MOE_PRED, and
LLAMA_MOE_PF_ALL from the previous patch) takes its slots from the
head of the cache's LRU list while the GPU may still be running the
layer that was just resolved. With LLAMA_MOE_SLRU only the unprotected
share of the slots is evictable, so a large LLAMA_MOE_PF_ALL read-ahead
could reach an expert that layer had just selected and overwrite it
while the GPU read it (wrong output on long prompts; found while
testing, in no release). The read-ahead now stops when the next victim
holds an expert selected by that layer. The count of such stops is
written as "# pf_guard N" to the LLAMA_MOE_STATS file.
---
 src/llama-moe-cache.cpp | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/src/llama-moe-cache.cpp b/src/llama-moe-cache.cpp
index b0725a67b..a4b06afd6 100644
--- a/src/llama-moe-cache.cpp
+++ b/src/llama-moe-cache.cpp
@@ -431,6 +431,9 @@ struct llama_moe_cache::impl {
     // layer il; after "go" of layer il the resolver reads the predicted misses of layer il + 1 while the GPU runs on
     int pred_mode = 0;
     long pf_all_min = 0; // LLAMA_MOE_PF_ALL (tokens, 0 = off)
+    int32_t inflight_il = -1;        // the last resolved layer (the GPU may be running its experts) and its selected experts
+    std::vector<uint8_t> inflight_sel;
+    size_t pf_guard = 0;             // read-aheads stopped because the next victim was such an expert
     int32_t pred_k_ = 0;
     std::vector<ggml_tensor *> pred_t;              // [il] tensor predicting layer il
     std::vector<std::vector<int32_t>> pred_ids;     // [il] predicted experts, read after "done" of layer il - 1
@@ -480,6 +483,7 @@ struct llama_moe_cache::impl {
         // prefetch is on by default (it only acts with the SSD async cache, see pred_k()); 6 experts measured best on a 16 GB MacBook Air
         pred_mode = (int) moe_env_long("LLAMA_MOE_PRED", 2);
         pf_all_min = moe_env_long("LLAMA_MOE_PF_ALL", 0);
+        inflight_sel.assign(model.hparams.n_expert, 0);
         pred_k_   = pred_mode > 0 ? (int32_t) moe_env_long("LLAMA_MOE_PRED_K", 6) : 0;
         pred_t.assign(model.layers.size(), nullptr);
         pred_ids.assign(model.layers.size(), {});
@@ -1118,6 +1122,7 @@ struct llama_moe_cache::impl {
             fprintf(stats_fp, "\n# pred k %d mode %d layers %zu actual %zu overlap %zu misses %zu covered %zu pf_reads %zu pf_used %zu pf_wait_ms %.1f",
                 pred_k_, pred_mode, pst.n_layers, pst.actual, pst.overlap, pst.misses, pst.covered, pst.pf_reads, pst.pf_used, pst.pf_wait_ns/1e6);
         }
+        fprintf(stats_fp, "\n# pf_guard %zu", pf_guard);
         fprintf(stats_fp, "\n# totals small hits %zu misses %zu bytes %zu | large hits %zu misses %zu bytes %zu\n",
                 stats_small.hits, stats_small.misses, stats_small.bytes, stats_large.hits, stats_large.misses, stats_large.bytes);
         }
@@ -1342,6 +1347,12 @@ struct llama_moe_cache::impl {
                 continue;
             }
             const int32_t s = g.lru.head;
+            // never evict an expert selected by the layer whose "go" was just signalled: the GPU may be reading it (with a segmented
+            // LRU only the unprotected share of the slots is evictable, and a large read-ahead can reach that layer's new experts)
+            if (g.lru.key_of[s] >= 0 && g.lru.key_of[s] / g.lru.n_expert == inflight_il && inflight_sel[g.lru.key_of[s] % g.lru.n_expert]) {
+                pf_guard++;
+                break;
+            }
             if (g.lru.key_of[s] >= 0) {
                 g.lru.slot_map[g.lru.key_of[s] / g.lru.n_expert][g.lru.key_of[s] % g.lru.n_expert] = -1;
             }
@@ -1408,6 +1419,14 @@ struct llama_moe_cache::impl {
             pf_layer = -1;
         }
 
+        inflight_il = il;
+        std::fill(inflight_sel.begin(), inflight_sel.end(), 0);
+        for (int32_t e : ids) {
+            if (e >= 0 && e < (int32_t) inflight_sel.size()) {
+                inflight_sel[e] = 1;
+            }
+        }
+
         size_t n_hit = 0;
         if (!g.lru.plan(il, ids.data(), ids.size(), fills, n_hit)) {
             GGML_ABORT("the MoE cache is too small for the experts selected in layer %d", il);
-- 
