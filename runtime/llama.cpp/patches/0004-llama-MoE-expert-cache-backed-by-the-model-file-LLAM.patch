diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
index ffbcba3..6e72f6a 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -1837,6 +1837,14 @@ static void ggml_backend_sched_copy_input(ggml_backend_sched_t sched, struct ggm
         return;
     }
 
+    // (tq expert cache) GGML_SCHED_COPY_CB_FIRST=1: the copy callback gets host weights BEFORE the backend is synchronized and
+    // takes over the synchronization (the asynchronous MoE expert cache); if it declines, the default path below runs
+    static const bool cb_first = getenv("GGML_SCHED_COPY_CB_FIRST") != NULL && atoi(getenv("GGML_SCHED_COPY_CB_FIRST")) != 0;
+    if (cb_first && sched->callback_copy != NULL && ggml_backend_sched_is_host_weight(input) &&
+        sched->callback_copy(split_backend, input, input_cpy, &split->graph, sched->callback_copy_user_data)) {
+        return;
+    }
+
     // wait for the split backend to finish using the input before overwriting it
     if (sched->events[split_backend_id][sched->cur_copy] != NULL) {
         ggml_backend_event_wait(split_backend, sched->events[split_backend_id][sched->cur_copy]);
@@ -1844,7 +1852,7 @@ static void ggml_backend_sched_copy_input(ggml_backend_sched_t sched, struct ggm
         ggml_backend_synchronize(split_backend);
     }
 
-    if (sched->callback_copy != NULL && ggml_backend_sched_is_host_weight(input) &&
+    if (!cb_first && sched->callback_copy != NULL && ggml_backend_sched_is_host_weight(input) &&
         sched->callback_copy(split_backend, input, input_cpy, &split->graph, sched->callback_copy_user_data)) {
         return;
     }
