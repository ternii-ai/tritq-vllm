diff --git a/ggml/src/ggml-metal/ggml-metal-context.m b/ggml/src/ggml-metal/ggml-metal-context.m
index e906466..46007fc 100644
--- a/ggml/src/ggml-metal/ggml-metal-context.m
+++ b/ggml/src/ggml-metal/ggml-metal-context.m
@@ -84,6 +84,15 @@
     bool has_error;
 };
 
+// (tq expert cache) MoE expert cache, asynchronous in-buffer mode: every graph_compute is ONE command buffer that starts with a
+// wait for the pending "go" value (if any) and ends with a "done" signal (see ggml_metal_moe_mark)
+static bool     g_moe_inbuf = false;
+static uint64_t g_moe_pending_go = 0;
+static id<MTLSharedEvent> g_moe_done_ev = nil;
+static id<MTLSharedEvent> g_moe_go_ev   = nil;
+static uint64_t g_moe_done_last = 0; // value signalled at the end of the last encoded graph_compute
+static uint64_t g_moe_go_last   = 0;
+
 ggml_metal_t ggml_metal_init(ggml_metal_device_t dev) {
     GGML_LOG_INFO("%s: allocating\n", __func__);
 
@@ -701,6 +710,105 @@ void ggml_metal_event_wait(ggml_metal_t ctx, ggml_metal_event_t ev) {
     }
 }
 
+void ggml_metal_moe_mark(ggml_metal_t ctx, uint64_t * v_done, uint64_t * v_go) {
+    if (!g_moe_inbuf) {
+        id<MTLDevice> device = (id<MTLDevice>) ggml_metal_device_get_obj(ctx->dev);
+        g_moe_done_ev = [device newSharedEvent];
+        g_moe_go_ev   = [device newSharedEvent];
+        ggml_metal_set_n_cb(ctx, 0);
+        g_moe_inbuf = true;
+        // nothing has signalled yet: the caller waits for the last graph_compute to complete the old way
+        ggml_metal_synchronize(ctx);
+        *v_done = 0;
+    } else {
+        *v_done = g_moe_done_last;
+    }
+    GGML_ASSERT(g_moe_pending_go == 0);
+    g_moe_pending_go = ++g_moe_go_last;
+    *v_go = g_moe_pending_go;
+}
+
+void ggml_metal_moe_inbuf_host_wait(uint64_t value, int spin) {
+    if (value == 0) {
+        return;
+    }
+    @autoreleasepool {
+        if (spin) {
+            while ([g_moe_done_ev signaledValue] < value) {
+            }
+        } else if (![g_moe_done_ev waitUntilSignaledValue:value timeoutMS:600000]) {
+            GGML_ABORT("%s: timeout", __func__);
+        }
+    }
+}
+
+void ggml_metal_moe_inbuf_host_signal(uint64_t value) {
+    @autoreleasepool {
+        g_moe_go_ev.signaledValue = value;
+    }
+}
+
+// (tq expert cache) MoE expert cache, asynchronous mode
+static id<MTLSharedEvent> g_moe_done = nil; // GPU -> host: the work before this point is complete
+static id<MTLSharedEvent> g_moe_go   = nil; // host -> GPU: the experts of the next layer are in place
+static uint64_t g_moe_done_v = 0;
+static uint64_t g_moe_go_v   = 0;
+
+static void ggml_metal_moe_init(ggml_metal_t ctx) {
+    if (g_moe_done == nil) {
+        id<MTLDevice> device = (id<MTLDevice>) ggml_metal_device_get_obj(ctx->dev);
+        g_moe_done = [device newSharedEvent];
+        g_moe_go   = [device newSharedEvent];
+    }
+}
+
+uint64_t ggml_metal_moe_signal_point(ggml_metal_t ctx) {
+    @autoreleasepool {
+        ggml_metal_moe_init(ctx);
+        id<MTLCommandQueue> queue = ggml_metal_device_get_queue(ctx->dev);
+        id<MTLCommandBuffer> cmd_buf = [queue commandBufferWithUnretainedReferences];
+        const uint64_t v = ++g_moe_done_v;
+        [cmd_buf encodeSignalEvent:g_moe_done value:v];
+        [cmd_buf commit];
+        [ctx->cmd_bufs_ext addObject:cmd_buf];
+        ctx->cmd_buf_last = cmd_buf;
+        [cmd_buf retain];
+        return v;
+    }
+}
+
+uint64_t ggml_metal_moe_wait_point(ggml_metal_t ctx) {
+    @autoreleasepool {
+        ggml_metal_moe_init(ctx);
+        id<MTLCommandQueue> queue = ggml_metal_device_get_queue(ctx->dev);
+        id<MTLCommandBuffer> cmd_buf = [queue commandBufferWithUnretainedReferences];
+        const uint64_t v = ++g_moe_go_v;
+        [cmd_buf encodeWaitForEvent:g_moe_go value:v];
+        [cmd_buf commit];
+        [ctx->cmd_bufs_ext addObject:cmd_buf];
+        ctx->cmd_buf_last = cmd_buf;
+        [cmd_buf retain];
+        return v;
+    }
+}
+
+void ggml_metal_moe_host_wait(uint64_t value, int spin) {
+    @autoreleasepool {
+        if (spin) {
+            while ([g_moe_done signaledValue] < value) {
+            }
+        } else if (![g_moe_done waitUntilSignaledValue:value timeoutMS:600000]) {
+            GGML_ABORT("%s: timeout", __func__);
+        }
+    }
+}
+
+void ggml_metal_moe_host_signal(uint64_t value) {
+    @autoreleasepool {
+        g_moe_go.signaledValue = value;
+    }
+}
+
 ggml_metal_event_t ggml_metal_get_ev_cpy(ggml_metal_t ctx) {
     return ctx->ev_cpy;
 }
@@ -743,6 +851,12 @@ void ggml_metal_set_n_cb(ggml_metal_t ctx, int n_cb) {
 
         id<MTLCommandBuffer> cmd_buf = ctx->cmd_bufs[cb_idx].obj;
 
+        const bool moe_inbuf = g_moe_inbuf && cb_idx == n_cb_l; // n_cb is 0 in this mode: the only command buffer
+        if (moe_inbuf && g_moe_pending_go != 0) {
+            [cmd_buf encodeWaitForEvent:g_moe_go_ev value:g_moe_pending_go];
+            g_moe_pending_go = 0;
+        }
+
         ggml_metal_op_t ctx_op = ggml_metal_op_init(
             ctx->dev,
             cmd_buf,
@@ -765,6 +879,10 @@ void ggml_metal_set_n_cb(ggml_metal_t ctx, int n_cb) {
 
         ggml_metal_op_free(ctx_op);
 
+        if (moe_inbuf) {
+            [cmd_buf encodeSignalEvent:g_moe_done_ev value:++g_moe_done_last];
+        }
+
         if (cb_idx < 2 || ctx->abort_callback == NULL) {
             [cmd_buf commit];
         }
