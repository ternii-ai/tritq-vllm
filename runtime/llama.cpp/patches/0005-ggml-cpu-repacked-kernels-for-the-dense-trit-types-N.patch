+    const int64_t nrows = src1_end - src1_start; \
+    const int64_t ncols = src0_end - src0_start; \
+    GGML_ASSERT(src1_ptr + src1_col_stride * nrows <= (const char *) params->wdata + params->wsize); \
+    GGML_ASSERT(src0_start % 4 == 0 && ncols % 4 == 0); \
